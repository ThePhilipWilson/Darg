<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Darg.Desktop.ViewModels"
        xmlns:views="using:Darg.Desktop.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Darg.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" Icon="/darg.ico" Title="Darg" Width="1500" Height="920" MinWidth="900" MinHeight="560">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- project tabs -->
    <Border Grid.Row="0" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Height="40" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <DockPanel.Styles>
          <Style Selector="Button, ListBox"><Setter Property="chrome:WindowDecorationProperties.ElementRole" Value="User"/></Style>
          <Style Selector="Button.caption"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/></Style>
          <Style Selector="Button.caption:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Line}"/></Style>
          <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Bad}"/></Style>
        </DockPanel.Styles>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" chrome:WindowDecorationProperties.ElementRole="User">
          <Button Classes="caption" Content="&#x2013;" Click="OnMinimize" AutomationProperties.Name="Minimize" ToolTip.Tip="Minimize"/>
          <Button Classes="caption" x:Name="MaxButton" Content="&#x25A1;" Click="OnMaximize" AutomationProperties.Name="Maximize" ToolTip.Tip="Maximize"/>
          <Button Classes="caption close" Content="&#x2715;" Click="OnClose" AutomationProperties.Name="Close" ToolTip.Tip="Close"/>
        </StackPanel>
        <!-- the wordmark is drawn about 9x smaller than its PNG: without HighQuality (mipmapped) sampling its edges go jagged -->
        <Image DockPanel.Dock="Left" Source="/wordmark.png" Height="34" VerticalAlignment="Center" Margin="14,0,16,0"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               ToolTip.Tip="Darg" AutomationProperties.Name="Darg"/>
        <Button DockPanel.Dock="Right" Content="🎨 Settings" Command="{Binding OpenSettingsCommand}" Background="Transparent"
                VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Darg's own settings: the theme (dark, light, girlypop)"
                AutomationProperties.Name="Settings"/>
        <Button DockPanel.Dock="Right" Content="⚙ Setup" Command="{Binding OpenSetupCommand}" Background="Transparent"
                VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Which projects this instance has, and which features each uses"/>
        <!-- restart, or update from the repo and restart: the build runs while Darg stays open -->
        <Button x:Name="RestartButton" DockPanel.Dock="Right" Content="{Binding Restart.HeaderLabel}" Background="Transparent"
                VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Restart Darg, or update it from its repo and restart"
                AutomationProperties.Name="Restart and update">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="360" Spacing="10" x:DataType="vm:RestartViewModel">
                <TextBlock Text="Restart Darg" FontWeight="Bold"/>
                <TextBlock Classes="dim small" Text="{Binding SourceNote}" TextWrapping="Wrap"/>
                <TextBlock Classes="small" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Accent}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding RestartLabel}" Command="{Binding RestartCommand}" ToolTip.Tip="Close and reopen this build"/>
                  <Button Classes="primary" Content="{Binding UpdateLabel}" Command="{Binding UpdateCommand}" IsVisible="{Binding CanUpdate}"
                          IsEnabled="{Binding !Building}"/>
                </StackPanel>
                <TextBlock Classes="dim small" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"/>
                <DockPanel IsVisible="{Binding HasFailure}">
                  <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissCommand}" Background="Transparent" Padding="6,0"
                          VerticalAlignment="Top" ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss update error"/>
                  <SelectableTextBlock Classes="small" Text="{Binding Failure}" TextWrapping="Wrap" Foreground="{DynamicResource Bad}"/>
                </DockPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button DockPanel.Dock="Right" Content="🔧 Tools" Command="{Binding OpenToolsCommand}" Background="Transparent"
                VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Forge, ComfyUI, Ollama, Pinokio and claude-draw on this machine"/>
        <!-- Claude usage (WOR-0069): the 5-hour window as a bar, the time until it resets, and the week; today's Claude time sits to its left -->
        <Border DockPanel.Dock="Right" IsVisible="{Binding Usage.Visible}" Background="Transparent" VerticalAlignment="Center"
                Margin="0,0,12,0" Padding="4,2" ToolTip.Tip="{Binding Usage.Tip}" AutomationProperties.Name="Claude usage"
                chrome:WindowDecorationProperties.ElementRole="User"
                Opacity="{Binding Usage.Opacity}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Width="64" Height="6" CornerRadius="3" Background="{DynamicResource Line}" VerticalAlignment="Center" ClipToBounds="True">
              <Panel>
                <Border HorizontalAlignment="Left" Width="{Binding Usage.FillWidth}" CornerRadius="3"
                        Background="{DynamicResource Accent}" IsVisible="{Binding !Usage.High}"/>
                <Border HorizontalAlignment="Left" Width="{Binding Usage.FillWidth}" CornerRadius="3"
                        Background="{DynamicResource Bad}" IsVisible="{Binding Usage.High}"/>
              </Panel>
            </Border>
            <TextBlock Classes="small" Text="{Binding Usage.Percent}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Ink}" IsVisible="{Binding !Usage.High}"/>
            <TextBlock Classes="small" Text="{Binding Usage.Percent}" VerticalAlignment="Center" FontWeight="Bold"
                       Foreground="{DynamicResource Bad}" IsVisible="{Binding Usage.High}"/>
            <TextBlock Classes="dim small" Text="{Binding Usage.Timer, StringFormat='⏱ {0}'}" VerticalAlignment="Center"
                       IsVisible="{Binding Usage.Timer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Classes="dim small" Text="{Binding Usage.Week}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <!-- today's Claude time, from claude-code-timer's timings (WOR-0069) -->
        <Border DockPanel.Dock="Right" IsVisible="{Binding Usage.Today, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0" Padding="4,2" ToolTip.Tip="{Binding Usage.TodayTip}"
                AutomationProperties.Name="Claude time today" chrome:WindowDecorationProperties.ElementRole="User">
          <TextBlock Classes="dim small" Text="{Binding Usage.Today}" VerticalAlignment="Center"/>
        </Border>
        <ListBox x:Name="ProjectTabs" ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}" Background="Transparent"
                 VerticalAlignment="Bottom">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="14,7"/>
              <Setter Property="Margin" Value="2,0"/>
              <Setter Property="CornerRadius" Value="8,8,0,0"/>
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource Panel}"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"/>
                <Border IsVisible="{Binding Agents.NeedingYou, FallbackValue=False}" Background="{DynamicResource Accent}"
                        CornerRadius="8" Padding="5,0" VerticalAlignment="Center">
                  <TextBlock Text="!" Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold"/>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- every project's view stays alive, so a terminal or an agent keeps going on another tab -->
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Projects}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><Panel/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ProjectViewModel">
          <views:ProjectView IsVisible="{Binding IsActive}"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="1" IsVisible="{Binding Empty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
      <TextBlock Text="No projects in this instance yet." FontSize="16" HorizontalAlignment="Center"/>
      <Button Classes="primary" Content="⚙ Set up projects" Command="{Binding OpenSetupCommand}" HorizontalAlignment="Center"/>
    </StackPanel>

    <!-- Fettle, the mascot: a box for talking to an assistant that can act on any project -->
    <!-- sits above the agents view's message bar, so it never covers Send -->
    <StackPanel x:Name="MascotStack" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,78" Spacing="10">
      <!-- the box moves where you drag its header (MainWindow.axaml.cs); a double-click on the header puts it back -->
      <Border x:Name="MascotBubble" Width="400" IsVisible="{Binding Mascot.Open}" Background="{DynamicResource Panel}" BorderBrush="{Binding FettleEdge}"
              BorderThickness="1" CornerRadius="14" BoxShadow="0 14 40 0 #90000000" HorizontalAlignment="Right">
        <DockPanel>
          <Border x:Name="MascotHeader" DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8"
                  Background="Transparent" Cursor="SizeAll" ToolTip.Tip="Drag to move · double-click to put it back">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="–" Command="{Binding Mascot.ToggleCommand}" Padding="8,0" Background="Transparent"
                        AutomationProperties.Name="Hide Fettle"/>
                <Button DockPanel.Dock="Right" Content="+ New chat" Command="{Binding Mascot.FreshCommand}" Padding="8,0" Background="Transparent"
                        FontSize="11" IsVisible="{Binding Mascot.HasChat}"/>
                <TextBlock Classes="dim small" VerticalAlignment="Center"
                           Text="{Binding Mascot.Agent.StateText, StringFormat='Fettle · {0}', FallbackValue='Fettle · new chat'}"/>
              </DockPanel>
              <!-- two tabs so the chat and the notifications never show at once -->
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton Content="Chat" Command="{Binding ShowChatTabCommand}" IsChecked="{Binding !ShowNotifications, Mode=OneWay}"
                              Padding="10,2" FontSize="11" Background="Transparent" AutomationProperties.Name="Fettle chat tab"/>
                <ToggleButton Command="{Binding ShowNotificationsTabCommand}" IsChecked="{Binding ShowNotifications, Mode=OneWay}"
                              Padding="10,2" FontSize="11" Background="Transparent"
                              Content="{Binding Notifications.Count, StringFormat='🔔 Notifications {0}'}"
                              ToolTip.Tip="Everything agents have notified you of this run" AutomationProperties.Name="Notifications"/>
              </StackPanel>
              <!-- earlier chats: pick one to carry on with it -->
              <DockPanel IsVisible="{Binding Mascot.Chats.Count}">
                <Button DockPanel.Dock="Right" Content="×" Command="{Binding Mascot.ForgetCommand}" IsVisible="{Binding Mascot.HasChat}"
                        Padding="6,0" Background="Transparent" ToolTip.Tip="Forget this chat" AutomationProperties.Name="Forget chat"/>
                <ComboBox ItemsSource="{Binding Mascot.Chats}" SelectedItem="{Binding Mascot.SelectedChat}" HorizontalAlignment="Stretch"
                          PlaceholderText="Earlier chats…" FontSize="12" AutomationProperties.Name="Fettle chats"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <DockPanel DockPanel.Dock="Bottom" IsVisible="{Binding !ShowNotifications}">
            <Button DockPanel.Dock="Right" Content="➤" Command="{Binding Mascot.SendCommand}" Background="Transparent"
                    AutomationProperties.Name="Send to Fettle" VerticalAlignment="Bottom" Margin="0,0,6,6"/>
            <TextBox x:Name="MascotBox" Text="{Binding Mascot.Compose}" BorderThickness="0,1,0,0" CornerRadius="0,0,0,14"
                     PlaceholderText="What needs fettling?" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" Padding="12,9"/>
          </DockPanel>
          <!-- every notification agents have raised; click one to open that agent -->
          <Border DockPanel.Dock="Top" IsVisible="{Binding ShowNotifications}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel Margin="12,6">
                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearNotificationsCommand}" Padding="6,0" Background="Transparent" FontSize="11"/>
                <TextBlock Classes="dim small" VerticalAlignment="Center" Text="Notifications"/>
              </DockPanel>
              <TextBlock Classes="dim small" Margin="12,0,12,8" Text="None yet." IsVisible="{Binding !Notifications.Count}"/>
              <ScrollViewer MaxHeight="380">
                <ItemsControl ItemsSource="{Binding Notifications}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenNotificationCommand}" CommandParameter="{Binding}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" Padding="12,5">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Sub}" Classes="dim small"/>
                          <TextBlock Text="{Binding Detail}" Classes="dim small" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Border IsVisible="{Binding !ShowNotifications}"><ScrollViewer x:Name="MascotScroll" MaxHeight="380" IsVisible="{Binding Mascot.HasChat}">
            <ItemsControl ItemsSource="{Binding Mascot.Items}" Margin="12,10" FontSize="13">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer></Border>
        </DockPanel>
      </Border>

      <Button x:Name="MascotCritter" Classes="critter" HorizontalAlignment="Right" Command="{Binding Mascot.ToggleCommand}" ToolTip.Tip="Fettle: ask it anything, or give it a job"
              AutomationProperties.Name="Fettle"
              Classes.working="{Binding Mascot.Agent.Working, FallbackValue=False}" Classes.needs="{Binding Mascot.Agent.NeedsYou, FallbackValue=False}">
        <Panel Classes="body" Width="58" Height="70">
          <Panel Width="58" Height="58" VerticalAlignment="Bottom">
            <Ellipse Width="58" Height="58">
              <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="35%,30%" Center="40%,35%" RadiusX="70%" RadiusY="70%">
                  <GradientStop Color="{Binding FettleLight}" Offset="0"/>
                  <GradientStop Color="{Binding FettleDark}" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse Classes="cheek" Margin="-30,12,0,0"/>
            <Ellipse Classes="cheek" Margin="30,12,0,0"/>
            <Panel Classes="eye" Margin="-18,-6,0,0">
              <Ellipse Fill="#2a1a08"/>
              <Ellipse Classes="glint"/>
            </Panel>
            <Panel Classes="eye" Margin="18,-6,0,0">
              <Ellipse Fill="#2a1a08"/>
              <Ellipse Classes="glint"/>
            </Panel>
            <!-- one mouth shows at a time: a smile, a flat line while it works, an "oh" when it needs you -->
            <Border Classes="mouth smile" Width="14" Height="6" Background="#2a1a08" CornerRadius="0,0,8,8" Margin="0,22,0,0"/>
            <Border Classes="mouth flat" Width="10" Height="3" Background="#2a1a08" CornerRadius="2" Margin="0,22,0,0"/>
            <Ellipse Classes="mouth oh" Width="8" Height="9" Stroke="#2a1a08" StrokeThickness="2.5" Margin="0,24,0,0"/>
            <Border Classes="badge" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Bad}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
              <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Panel>
          <!-- a curl of wood shaving on its head: it lives on a workbench -->
          <Path Classes="shaving" Stroke="{Binding FettleShaving}" Data="M 26,15 C 23,5 36,1 38,9 C 39,14 33,15 32,11" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Panel>
      </Button>
    </StackPanel>

    <!-- Setup covers the projects while it's open -->
    <ContentControl Grid.Row="1" Content="{Binding Setup}" IsVisible="{Binding Setup, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:SetupViewModel"><views:SetupView/></DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
    <ContentControl Grid.Row="1" Content="{Binding ToolsPage}" IsVisible="{Binding ToolsPage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:ToolsViewModel"><views:ToolsView/></DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
    <ContentControl Grid.Row="1" Content="{Binding SettingsPage}" IsVisible="{Binding SettingsPage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView/></DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>

    <Border Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
      <TextBlock Classes="dim small" Text="{Binding Selected.StatusLine, FallbackValue=''}"/>
    </Border>
  </Grid>
</Window>
