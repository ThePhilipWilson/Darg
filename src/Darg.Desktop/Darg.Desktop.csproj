<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- One codebase: built on Windows it targets the Windows SDK (for toast notifications that
         reopen the app at an agent); elsewhere plain net10.0. WINDOWS is defined in the first case. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>darg.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="darg.png" />
    <AvaloniaResource Include="darg.ico" />
    <AvaloniaResource Include="wordmark.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="4.1.4" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- the toast package asks for 4.7.0, which has a critical advisory (GHSA-rxg9-xrhp-64gj) -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.15" />
    <!-- voice in (WOR-0118): local Whisper over the mic; the model (small.en) is downloaded on first use -->
    <PackageReference Include="NAudio.WinMM" Version="2.3.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- the GPU path (any Vulkan card, no CUDA install): 0.2 s a phrase against 8 s on the CPU; it falls back to the CPU -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- A live copy (WOR-0126, tools/live.ps1) runs under dotnet watch: C# changes apply through .NET hot reload,
       .axaml changes through HotAvalonia. Only in the Debug builds live.ps1 starts (MSBuild sees its DARG_LIVE_TREE
       variable), so other debug builds and the published Release copy are as they were. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug' And '$(DARG_LIVE_TREE)' != ''">
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.6" PrivateAssets="All" />
    <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Darg.Core\Darg.Core.csproj" />
  </ItemGroup>
</Project>
