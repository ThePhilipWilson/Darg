<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Desktop.ViewModels"
             x:Class="Darg.Desktop.Views.ConsolesView"
             x:DataType="vm:ConsolesViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <!-- saved commands: one click opens a console running it -->
        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Commands}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ConsolesViewModel+CommandButton">
              <Button Content="{Binding Name, StringFormat='▶ {0}'}" ToolTip.Tip="{Binding Tip}"
                      Command="{Binding $parent[UserControl].((vm:ConsolesViewModel)DataContext).RunCommandCommand}" CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- + Shell opens the default shell; ▾ lists every shell installed here, and the one picked becomes the default -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
          <Button Content="+ Shell" Command="{Binding NewShellCommand}" ToolTip.Tip="{Binding NewShellTip}"/>
          <Button Content="▾" Padding="6,0" Margin="1,0,0,0" ToolTip.Tip="Open another shell" AutomationProperties.Name="Choose shell">
            <Button.Flyout>
              <MenuFlyout ItemsSource="{Binding ShellChoices}" Placement="BottomEdgeAlignedLeft">
                <MenuFlyout.ItemContainerTheme>
                  <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:ConsolesViewModel+ShellChoice">
                    <Setter Property="Header" Value="{Binding Name}"/>
                    <Setter Property="Command" Value="{Binding OpenCommand}"/>
                    <Setter Property="ToolTip.Tip" Value="{Binding Tip}"/>
                  </ControlTheme>
                </MenuFlyout.ItemContainerTheme>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <!-- a project with several repos: which one a new shell opens in -->
          <ComboBox ItemsSource="{Binding RepoChoices}" SelectedItem="{Binding SelectedRepo}" IsVisible="{Binding HasRepoChoice}"
                    Margin="6,0,0,0" MinWidth="110" ToolTip.Tip="The repo a new shell opens in" AutomationProperties.Name="Shell repo">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:RepoChoice"><TextBlock Text="{Binding Name, StringFormat='in {0}'}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <ListBox x:Name="ConsoleTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ConsoleTab">
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Cwd}">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Classes.dim="{Binding Ended}"/>
                <Button Content="×" Command="{Binding CloseCommand}" Padding="4,0" Background="Transparent" MinHeight="0"
                        AutomationProperties.Name="Close console"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <!-- every console's terminal stays alive; only the selected one shows -->
    <Panel x:Name="Hosts" Background="Black"/>
  </DockPanel>
</UserControl>
