<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Desktop.ViewModels"
             xmlns:views="using:Darg.Desktop.Views"
             x:Class="Darg.Desktop.Views.AgentsView"
             x:DataType="vm:AgentsViewModel">
  <Grid ColumnDefinitions="280,*">
    <!-- agent list -->
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- the new-agent box is a popup (WOR-0240): + New agent opens it, starting an agent closes it -->
        <Button x:Name="NewAgentButton" DockPanel.Dock="Bottom" Classes="primary" Margin="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Content="+ New agent" AutomationProperties.Name="New agent">
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft" ShowMode="Standard">
              <StackPanel Width="340" Spacing="6">
                <TextBox Text="{Binding NewPrompt}" PlaceholderText="What should a new agent do?" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                         views:EnterSends.Command="{Binding StartAgentCommand}" AutomationProperties.Name="New agent prompt"/>
                <TextBlock Classes="dim small" Text="{Binding Folder, StringFormat='Runs in {0}'}" TextWrapping="Wrap" IsVisible="{Binding !HasRepoChoice}"/>
                <!-- a project with several repos: pick which one the agent starts in; it is given the others too -->
                <DockPanel IsVisible="{Binding HasRepoChoice}">
                  <TextBlock DockPanel.Dock="Left" Classes="dim small" Text="Runs in" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox ItemsSource="{Binding RepoChoices}" SelectedItem="{Binding SelectedRepo}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="{Binding Folder, StringFormat='Starts in {0}; the other repos are added too'}"
                            AutomationProperties.Name="Agent repo">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:RepoChoice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </DockPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="✎ Profiles" Command="{Binding EditProfilesCommand}" Margin="6,0,0,0" Padding="8,4"
                          ToolTip.Tip="Model profiles: which model and effort a new agent starts on, by rule or picked by Haiku from the task (profiles.md)"
                          AutomationProperties.Name="Edit model profiles"/>
                  <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Start" Command="{Binding StartAgentCommand}"
                          AutomationProperties.Name="Start new agent"/>
                </DockPanel>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <ScrollViewer>
        <StackPanel>
        <DockPanel Margin="12,6,8,0">
          <ToggleButton DockPanel.Dock="Right" Content="By status" FontSize="11" Padding="6,1" MinHeight="0" Background="Transparent"
                        IsChecked="{Binding SortByStatus}" Margin="0,0,4,0" AutomationProperties.Name="Sort agents by status"
                        ToolTip.Tip="Group the list by status: needs you, working, failed, done, saved. Off: newest first."/>
          <Button DockPanel.Dock="Right" Content="Clear finished" FontSize="11" Padding="6,1" MinHeight="0" Background="Transparent"
                  Command="{Binding ClearFinishedCommand}" Margin="0,0,4,0"
                  ToolTip.Tip="Forget every finished agent here: done ones, and saved ones whose card is done. Working, waiting and failed agents stay. Claude Code keeps their history."/>
          <Button DockPanel.Dock="Right" Content="Close idle" FontSize="11" Padding="6,1" MinHeight="0" Background="Transparent"
                  Command="{Binding CloseIdleCommand}" ToolTip.Tip="Close the session of every idle agent here. They stay listed; send one a message to carry on."/>
          <Button DockPanel.Dock="Right" Content="↻ Continue all" FontSize="11" Padding="6,1" MinHeight="0" Background="Transparent"
                  Command="{Binding ContinueAllCommand}" IsVisible="{Binding AnyOutOfUsage}" Margin="0,0,4,0"
                  ToolTip.Tip="Continue all after reset: every agent here that ran out of usage carries on when the limit resets."/>
          <TextBlock Text="This project" Classes="dim small" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Tabs}" IsVisible="{Binding HasTabs}" Margin="12,6,8,2">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentBoardTab">
              <Button Classes="chip boardtab" Classes.all="{Binding IsShown}" Content="{Binding Name}" Command="{Binding PickCommand}"
                      Margin="0,0,4,4" Padding="10,2" FontSize="12" AutomationProperties.Name="{Binding Name, StringFormat='Agents tab {0}'}"
                      ToolTip.Tip="Click: show only the agents on this board's cards. Ctrl+click: add it to the boards showing, or take it off."/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ListBox ItemsSource="{Binding Listed}" SelectedItem="{Binding Selected}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentViewModel">
              <!-- its state at a glance: a coloured bar and dot (blue working, amber needs you, green done,
                   red failed, grey saved), what it's doing or how it finished, and a bold name for news not yet seen -->
              <DockPanel Classes="agentstate" Classes.working="{Binding Working}" Classes.needs="{Binding NeedsYou}"
                         Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}" Classes.unseen="{Binding Unseen}">
                <Border DockPanel.Dock="Left" Classes="bar" Width="3" CornerRadius="2" Margin="-6,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Background="Transparent" MinHeight="0" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:AgentsViewModel)DataContext).ForgetCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Forget this agent (Claude Code keeps its own history)" AutomationProperties.Name="Forget agent"/>
                <StackPanel Spacing="2">
                  <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="dot" Width="7" Height="7" VerticalAlignment="Center"/>
                    <TextBlock Classes="state small" Text="{Binding StateText}"/>
                  </StackPanel>
                  <TextBlock Classes="dim small" Text="{Binding Activity}" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding Activity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="{Binding Activity}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="No agents yet." Classes="dim small" Margin="12,2,12,6" IsVisible="{Binding !Agents.Count}"/>

        <!-- Fettle's chats started in this project (Fettle lists the project on screen) -->
        <TextBlock Text="Fettle chats" Classes="dim small" Margin="12,14,12,4"/>
        <ListBox ItemsSource="{Binding Mascot.Chats, FallbackValue={x:Null}}" SelectedItem="{Binding BenchChat}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatEntry">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Background="Transparent" MinHeight="0" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:AgentsViewModel)DataContext).ForgetChatCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Forget this Fettle chat (Claude Code keeps its own history)" AutomationProperties.Name="Forget chat"/>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Classes="dim small" Text="{Binding When, StringFormat='Fettle · {0}'}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="None yet: talk to Fettle (bottom right)." Classes="dim small" Margin="12,2,12,6"
                   IsVisible="{Binding !Mascot.Chats.Count, FallbackValue=True}"/>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- the selected agent -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" DataContext="{Binding Shown}" x:DataType="vm:AgentViewModel"
          IsVisible="{Binding $parent[UserControl].((vm:AgentsViewModel)DataContext).Shown, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
        <StackPanel Spacing="4">
        <DockPanel IsVisible="{Binding InFlow}">
          <Button DockPanel.Dock="Right" Content="Stop flow" Command="{Binding Flow.StopFlowCommand, FallbackValue={x:Null}}" Padding="8,2"
                  IsVisible="{Binding Flow.Running, FallbackValue=False}" ToolTip.Tip="Nothing more is handed on; the agent at work finishes its turn"/>
          <TextBlock Classes="dim small" Foreground="{DynamicResource Accent}" Text="{Binding Flow.Status, StringFormat='Flow · {0}', FallbackValue=''}" VerticalAlignment="Center"/>
        </DockPanel>
        <!-- out of usage: Darg waits for the limit to reset and then tells the agent to carry on (no AI runs meanwhile) -->
        <DockPanel IsVisible="{Binding LimitHit}">
          <Button DockPanel.Dock="Right" Classes="primary" Content="↻ Continue after reset" Command="{Binding ContinueAfterResetCommand}" Padding="8,2"
                  IsVisible="{Binding CanContinueAfterReset}" AutomationProperties.Name="Continue after reset"
                  ToolTip.Tip="When the usage limit resets, send this agent a message to carry on where it left off. Darg must be running then (it carries on when it next opens if not)."/>
          <Button DockPanel.Dock="Right" Content="Don't continue" Command="{Binding CancelContinueCommand}" Padding="8,2"
                  IsVisible="{Binding WaitingForReset}" AutomationProperties.Name="Don't continue"/>
          <TextBlock Classes="small" Foreground="{DynamicResource Accent}" Text="{Binding LimitLine}" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" IsEnabled="{Binding Open}" Margin="6,0,0,0"
                  ToolTip.Tip="End this agent's Claude session. The agent stays listed; send it a message to carry on." AutomationProperties.Name="Close session"/>
          <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding Working}"
                  ToolTip.Tip="Stop the turn in progress; the session stays open"/>
          <!-- change the session as it runs: from its next turn (a saved agent starts with these when it resumes) -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0">
            <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding ModelChoice}" FontSize="12" MinHeight="0" Padding="8,3"
                      ToolTip.Tip="Model, from the next turn" AutomationProperties.Name="Model"/>
            <ComboBox ItemsSource="{Binding EffortChoices}" SelectedItem="{Binding EffortChoice}" FontSize="12" MinHeight="0" Padding="8,3"
                      ToolTip.Tip="Effort, from the next turn" AutomationProperties.Name="Effort"/>
            <ComboBox ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding ModeChoice}" FontSize="12" MinHeight="0" Padding="8,3"
                      ToolTip.Tip="Permission mode" AutomationProperties.Name="Permission mode"/>
          </StackPanel>
          <!-- a DockPanel, not a StackPanel, so the folder (last) gets only the room left and trims instead of running under the pickers -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Classes="agentstate" Classes.working="{Binding Working}" Classes.needs="{Binding NeedsYou}"
                        Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}">
              <Ellipse Classes="dot" Width="7" Height="7" VerticalAlignment="Center"/>
              <TextBlock Classes="state small" Text="{Binding StateText}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button DockPanel.Dock="Left" Margin="0,0,12,0" Padding="6,1" MinHeight="0" FontSize="11" Background="Transparent"
                    Content="{Binding CardLabel}" IsVisible="{Binding HasCard}" Command="{Binding ShowCardCommand}"
                    ToolTip.Tip="Show this agent's card on the board" AutomationProperties.Name="Show card"/>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Classes="dim small mono" Text="{Binding Model}" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Classes="dim small" Text="{Binding Billing}" VerticalAlignment="Center"/>
            <TextBlock Classes="dim small mono" Text="{Binding Cwd}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Cwd}"/>
          </DockPanel>
        </DockPanel>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="1" x:Name="Scroll">
        <!-- virtualised (WOR-0230): only the entries on screen are built, so switching agents doesn't build a whole long transcript -->
        <ItemsControl Classes="transcript" ItemsSource="{Binding Items}" Margin="18,14" MaxWidth="980" HorizontalAlignment="Left" AutomationProperties.Name="Transcript">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
          <Button DockPanel.Dock="Right" Content="✗ Mistake" Command="{Binding MistakeCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                  IsVisible="{Binding MistakeLogFile, Converter={x:Static ObjectConverters.IsNotNull}}" AutomationProperties.Name="Log a mistake"
                  ToolTip.Tip="The agent's last reply was a mistake: it writes an entry in the project's mistake log (Mistakes in the rail). What you've typed says what was wrong; leave it empty and the agent works it out or asks."/>
          <Button DockPanel.Dock="Right" Content="✎ Draw" Command="{Binding DrawCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                  ToolTip.Tip="Ask this agent for a canvas (claude-draw). What you've typed says what it's about; the drawing comes back here."/>
          <Button DockPanel.Dock="Right" Content="🎙" views:Dictation.Target="{Binding #ComposeBox}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                  AutomationProperties.Name="Dictate"/>
          <TextBox x:Name="ComposeBox" Text="{Binding Compose}" PlaceholderText="Message this agent… (Enter sends, Shift+Enter for a new line)"
                   AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" views:EnterSends.Command="{Binding SendCommand}"/>
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                IsVisible="{Binding Shown, Converter={x:Static ObjectConverters.IsNull}}">
      <TextBlock Text="No agent selected" FontSize="16" HorizontalAlignment="Center"/>
      <TextBlock Classes="dim" Text="Describe a job on the left to start one." HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
