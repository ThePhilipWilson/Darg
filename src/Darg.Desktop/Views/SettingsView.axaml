<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Desktop.ViewModels"
             x:Class="Darg.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource Bg}">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}"/>
        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="20,16" Spacing="10">
        <TextBlock Text="Theme" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Classes="dim small" Text="Shows at once and is kept for next time (settings.json in the instance folder)."/>
        <ItemsControl ItemsSource="{Binding Themes}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThemeChoice">
              <!-- a card per theme: a little window drawn in its own colours, whatever theme is on -->
              <Button Command="{Binding PickCommand}" Classes="theme" Classes.current="{Binding IsCurrent}" Padding="0" Margin="0,0,16,16"
                      Background="Transparent" Cursor="Hand" AutomationProperties.Name="{Binding AutomationName}">
                <Border Classes="frame" Width="260" CornerRadius="12" BorderThickness="2" Padding="10">
                  <StackPanel Spacing="10">
                    <Border Height="130" CornerRadius="8" ClipToBounds="True" Background="{Binding Bg}" BorderBrush="{Binding Line}" BorderThickness="1">
                      <DockPanel>
                        <Border DockPanel.Dock="Top" Height="20" Background="{Binding Chrome}" BorderBrush="{Binding Line}" BorderThickness="0,0,0,1">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Theme.Mark}" Foreground="{Binding Accent}" FontSize="10" FontWeight="Bold"/>
                            <Border Width="34" Height="6" CornerRadius="3" Background="{Binding Panel2}" VerticalAlignment="Center"/>
                            <Border Width="26" Height="6" CornerRadius="3" Background="{Binding Panel2}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Left" Width="22" Background="{Binding Panel}" BorderBrush="{Binding Line}" BorderThickness="0,0,1,0">
                          <StackPanel Spacing="6" Margin="0,8">
                            <Ellipse Width="8" Height="8" Fill="{Binding Accent}"/>
                            <Ellipse Width="8" Height="8" Fill="{Binding Dim}"/>
                            <Ellipse Width="8" Height="8" Fill="{Binding Dim}"/>
                          </StackPanel>
                        </Border>
                        <StackPanel Margin="10,8" Spacing="6">
                          <TextBlock Text="Board" Foreground="{Binding Ink}" FontSize="11" FontWeight="SemiBold"/>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="60" Height="34" CornerRadius="4" Background="{Binding Panel2}" BorderBrush="{Binding Line}" BorderThickness="1" Padding="5,4">
                              <StackPanel Spacing="4">
                                <Border Height="4" CornerRadius="2" Background="{Binding Ink}" Opacity="0.7"/>
                                <Border Height="4" Width="30" HorizontalAlignment="Left" CornerRadius="2" Background="{Binding Dim}"/>
                              </StackPanel>
                            </Border>
                            <Border Width="60" Height="34" CornerRadius="4" Background="{Binding Panel2}" BorderBrush="{Binding Line}" BorderThickness="1" Padding="5,4">
                              <StackPanel Spacing="4">
                                <Border Height="4" CornerRadius="2" Background="{Binding Ink}" Opacity="0.7"/>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                  <Ellipse Width="6" Height="6" Fill="{Binding Ok}"/>
                                  <Ellipse Width="6" Height="6" Fill="{Binding Info}"/>
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <Border HorizontalAlignment="Left" CornerRadius="4" Background="{Binding Accent}" Padding="8,2">
                            <TextBlock Text="Work on" Foreground="{Binding OnAccent}" FontSize="9" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="✓ On" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" IsVisible="{Binding IsCurrent}"/>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Classes="dim small" Text="{Binding Blurb}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Phone notifications" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/>
        <TextBlock Classes="dim small" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                   Text="What makes a desktop notification also goes to your phone through ntfy, even with the phone locked. A card waiting on your decision shows its options as buttons: tap one and Darg answers the card. Install the ntfy app, subscribe to the topic below on the server below, and keep the topic secret: anyone who knows it can read it."/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding PushServer}" Width="200" Watermark="https://ntfy.sh" AutomationProperties.Name="ntfy server"/>
          <TextBox Text="{Binding PushTopic}" Width="300" Watermark="topic (blank: off)" AutomationProperties.Name="ntfy topic"/>
          <Button Content="Save" Command="{Binding SavePushCommand}"/>
          <Button Content="✦ New topic" Command="{Binding NewPushTopicCommand}" AutomationProperties.Name="New topic"/>
          <Button Content="🔔 Send test" Command="{Binding PushTestCommand}" AutomationProperties.Name="Send test"/>
          <Button Content="Turn off" Command="{Binding PushOffCommand}"/>
        </StackPanel>
        <SelectableTextBlock Classes="dim small" Text="{Binding PushState}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>
        <TextBlock Classes="bad" Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"/>

        <!-- phone access (AND-0002): pair by QR, list and revoke paired phones -->
        <StackPanel DataContext="{Binding Phone}" x:DataType="vm:PhoneViewModel" Spacing="10" Margin="0,18,0,0">
          <TextBlock Text="Phone" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Classes="dim small" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                     Text="A paired phone reaches this app's projects, cards and agents, over an encrypted link on the home network or Tailscale. Each phone gets a token of its own; revoke one here and its next call is refused."/>
          <TextBlock Classes="dim small" Text="{Binding State}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Allowed}">
            <Button Content="📱 Pair a phone" Command="{Binding PairCommand}" IsVisible="{Binding !Pairing}"/>
            <Button Content="Cancel pairing" Command="{Binding CancelPairCommand}" IsVisible="{Binding Pairing}"/>
          </StackPanel>
          <Border IsVisible="{Binding Pairing}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="10" Padding="14" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="18">
              <!-- a QR is black on white whatever the theme: scanners want that, so it's a fixed surface like the post-its -->
              <Border Background="White" Padding="16" CornerRadius="6">
                <Path Data="{Binding Qr}" Fill="Black" Stretch="Uniform" Width="220" Height="220" AutomationProperties.Name="Pairing QR code"/>
              </Border>
              <StackPanel Spacing="8" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Text="Scan this with Darg on the phone" FontWeight="SemiBold"/>
                <TextBlock Classes="dim small" Text="or type the code:" />
                <SelectableTextBlock Text="{Binding Code}" FontSize="26" FontWeight="SemiBold" FontFamily="Consolas,Menlo,monospace"/>
                <TextBlock Classes="dim small" Text="{Binding Countdown}"/>
                <SelectableTextBlock Classes="dim small" Text="{Binding PairUri}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="dim small" Text="No phone paired yet." IsVisible="{Binding NoDevices}"/>
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhoneDevice">
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8"
                        Margin="0,0,0,6" HorizontalAlignment="Left" MinWidth="420">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Revoke" Command="{Binding RevokeCommand}" AutomationProperties.Name="{Binding RevokeName}" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Classes="dim small" Text="{Binding Seen}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  <UserControl.Styles>
    <Style Selector="Button.theme Border.frame">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
    </Style>
    <Style Selector="Button.theme:pointerover Border.frame">
      <Setter Property="BorderBrush" Value="{DynamicResource CardHoverLine}"/>
    </Style>
    <Style Selector="Button.theme.current Border.frame">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
    <Style Selector="Button.theme:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.theme:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>
</UserControl>
