<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Desktop.ViewModels"
             xmlns:views="using:Darg.Desktop.Views"
             xmlns:core="using:Darg.Core"
             x:Class="Darg.Desktop.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <UserControl.Styles>
    <!-- a column's Pick all: faint until the pointer is on the column, or while the column is all picked -->
    <Style Selector="Border.list:pointerover Button.colpick, Button.colpick.on">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.head">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="Border.list:pointerover Button.head"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Button.enlarge">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.enlarge:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.rowdivider:pointerover > Border"><Setter Property="Background" Value="{DynamicResource Accent}"/></Style>
    <Style Selector="Button.bulk">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.strip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Padding" Value="0,10"/>
    </Style>
    <!-- a card's type: a red Bug pill; another type a file names, grey -->
    <Style Selector="Border.kind"><Setter Property="Background" Value="{DynamicResource LabelBg}"/></Style>
    <Style Selector="Border.kind TextBlock"><Setter Property="Foreground" Value="{DynamicResource LabelInk}"/></Style>
    <Style Selector="Border.kind.bug"><Setter Property="Background" Value="{DynamicResource BugBg}"/></Style>
    <Style Selector="Border.kind.bug TextBlock"><Setter Property="Foreground" Value="{DynamicResource BugInk}"/></Style>
    <!-- WOR-0156: the ticket quality star beside a card's id -->
    <Style Selector="TextBlock.quality"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></Style>
    <Style Selector="TextBlock.quality.zero"><Setter Property="Foreground" Value="{DynamicResource Zero}"/></Style>
    <Style Selector="TextBlock.quality.amber"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></Style>
    <Style Selector="TextBlock.quality.green"><Setter Property="Foreground" Value="{DynamicResource Ok}"/></Style>
    <!-- WOR-0172: a blocker still open on a tile, outlined in the Warn colour -->
    <Style Selector="Border.blocker">
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="Margin" Value="0,0,4,2"/>
    </Style>
    <!-- the panel's Blocked by / Blocks links: a card id that opens the card -->
    <Style Selector="Button.blocklink">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0,1"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.blocklink TextBlock"><Setter Property="Foreground" Value="{DynamicResource Dim}"/></Style>
    <Style Selector="Button.blocklink.open TextBlock"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></Style>
    <Style Selector="Button.blocklink:pointerover TextBlock"><Setter Property="TextDecorations" Value="Underline"/></Style>
  </UserControl.Styles>
  <Panel>
  <Grid ColumnDefinitions="*,Auto">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <!-- what just happened, whole and wrapped (WOR-0173 QA: cut off in the header, it lost which cards were left out) -->
        <DockPanel DockPanel.Dock="Bottom" IsVisible="{Binding ShowsNotice}" Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" Classes="head" Opacity="1" Content="✕" Command="{Binding DismissNoticeCommand}" VerticalAlignment="Top"
                  ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss the board's notice"/>
          <SelectableTextBlock x:Name="Notice" Classes="dim" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <Button DockPanel.Dock="Left" Content="+ Board" Command="{Binding NewBoardCommand}" Margin="0,0,12,0"
                ToolTip.Tip="Make a new board, or have an agent sort the cards into a board per story"/>
        <!-- the tabs' order (WOR-0213): drag a tab to move it; these sort them once, and dragging carries on from there -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" IsVisible="{Binding ShowsBoardSort}">
          <Button Content="A–Z" Command="{Binding SortBoardsByNameCommand}" Padding="8,4" FontSize="12" AutomationProperties.Name="Sort boards A to Z"
                  ToolTip.Tip="Sort the board tabs A to Z. It sorts them once: drag a tab afterwards to move it, and new boards go at the end."/>
          <Button Content="Old–new" Command="{Binding SortBoardsByAgeCommand}" Padding="8,4" FontSize="12" AutomationProperties.Name="Sort boards oldest first"
                  ToolTip.Tip="Sort the board tabs oldest board first, by when each was made. It sorts them once: drag a tab afterwards to move it, and new boards go at the end."/>
        </StackPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="+ Card" Command="{Binding NewCardCommand}" Margin="12,0,0,0"/>
        <CheckBox DockPanel.Dock="Right" Content="Show completed" IsChecked="{Binding ShowCompleted}" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Classes="dim" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <TextBlock Text="{Binding PickedText}" IsVisible="{Binding HasPicked}" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
          <Button Classes="primary" Content="{Binding WorkOnPickedText}" Command="{Binding WorkOnPickedCommand}" IsVisible="{Binding CanWorkOnPicked}"
                  ToolTip.Tip="Start an agent on each picked card, all at once in the project's folder; each is told which others are running beside it. Cards that already have an agent are skipped."/>
          <Button Content="{Binding ImprovePickedText}" Command="{Binding ImprovePickedCommand}" IsVisible="{Binding CanWorkOnPicked}"
                  ToolTip.Tip="Improve each picked card: an agent per card fills its description out (what's wanted, where in the code, done when), asking you first if the words are unclear. The work itself isn't done. Cards that already have an agent are skipped."/>
          <Button Content="Unpick" Command="{Binding ClearPickedCommand}" IsVisible="{Binding HasPicked}" ToolTip.Tip="Unpick every card (Esc)"/>
          <Button Content="Pick all" Command="{Binding PickAllCommand}"
                  ToolTip.Tip="Pick every card showing (Ctrl+A). A column's own Pick all picks just that column; Ctrl- or Shift-click picks one at a time."/>
        </StackPanel>
        <views:OverflowRow DockPanel.Dock="Left" x:Name="BoardTabRow" Reserve="200" Margin="0,0,12,0">
        <ItemsControl x:Name="BoardTabs" ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:OverflowTabsPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BoardTab">
              <Button Classes="chip boardtab" Classes.all="{Binding IsShown}" Content="{Binding Name}" Command="{Binding PickCommand}"
                      Margin="0" Padding="12,4" FontSize="13" AutomationProperties.Name="{Binding Name}"
                      ToolTip.Tip="Click: show only this board. Ctrl+click: add it to the boards showing, or take it off. Drag: move the tab."/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </views:OverflowRow>
        <TextBox Text="{Binding Filter}" PlaceholderText="Filter by ID, title or description…" MaxWidth="460" HorizontalAlignment="Left" MinWidth="60"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8,14,3">
      <ItemsControl ItemsSource="{Binding Labels}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LabelChip">
            <Button Classes="chip" Classes.any="{Binding IsAny}" Classes.all="{Binding IsAll}" Content="{Binding Shown}" Command="{Binding ClickCommand}"
                    ToolTip.Tip="Click: any of these labels. Double-click: must have this one."/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- the boards on screen, a row each (WOR-0087): the picked one, then any shown with it; taller than the space, they scroll -->
    <ScrollViewer Grid.Row="2" x:Name="RowsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BoardViewModel">
    <DockPanel Height="{Binding RowHeight}">
      <Border DockPanel.Dock="Top" IsVisible="{Binding ShowsHeader}" Padding="16,8,14,0">
        <DockPanel>
          <!-- a further row's notice, whole (the first row's shows under the section's header) -->
          <SelectableTextBlock DockPanel.Dock="Bottom" Classes="dim small" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding ShowsRowNotice}" Margin="0,4,0,0"/>
          <Button DockPanel.Dock="Right" Classes="head" Opacity="1" Content="✕" Command="{Binding HideRowCommand}" IsVisible="{Binding IsExtraRow}"
                  ToolTip.Tip="Stop showing this board here" AutomationProperties.Name="{Binding SelectedBoard, StringFormat='Hide {0}'}"/>
          <TextBlock Classes="dim small" Text="{Binding CountText}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" DockPanel.Dock="Right"/>
          <TextBlock Text="{Binding SelectedBoard}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <!-- the divider below a row (WOR-0160): drag it to make this board taller or shorter, double-click to share again -->
      <Border DockPanel.Dock="Bottom" Classes="rowdivider" Tag="{Binding}" IsVisible="{Binding ShowsHeader}" Height="9" Background="Transparent"
              Cursor="SizeNorthSouth" ToolTip.Tip="Drag to resize this board; double-click to share the height again"
              AutomationProperties.Name="{Binding SelectedBoard, StringFormat='Resize {0}'}">
        <Border Height="3" Margin="40,0" CornerRadius="2" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
      </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal">
      <ItemsControl ItemsSource="{Binding Lists}" Margin="10">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ListViewModel">
            <Panel>
            <!-- minimized: a narrow strip with its name running down it; a click opens it, cards still drop on it -->
            <Border Width="38" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                    Tag="{Binding Key}" Classes="list" IsVisible="{Binding IsMinimized}">
              <Button Classes="strip" Command="{Binding ToggleMinimizedCommand}" ToolTip.Tip="{Binding Name, StringFormat='Open {0}'}"
                      AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="dim small" Text="{Binding Count}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                  <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Top">
                    <LayoutTransformControl.LayoutTransform><RotateTransform Angle="90"/></LayoutTransformControl.LayoutTransform>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Dim}"/>
                  </LayoutTransformControl>
                </DockPanel>
              </Button>
            </Border>
            <Border Width="290" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                    Tag="{Binding Key}" Classes="list" IsVisible="{Binding IsOpen}">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
                  <StackPanel Spacing="6">
                    <DockPanel IsVisible="{Binding IsHeaderPlain}">
                      <Button DockPanel.Dock="Right" Classes="head" Content="⋯" ToolTip.Tip="Rename, minimize or remove this list"
                              AutomationProperties.Name="{Binding Name, StringFormat='{}{0} menu'}">
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Wrap up into stories…" Command="{Binding WrapUpCommand}" IsVisible="{Binding IsDoneColumn}"
                                      ToolTip.Tip="An agent groups these cards into stories (a doc each and a Story card here), asks you, then moves the cards to Completed"/>
                            <MenuItem Header="{Binding ManualText}" Command="{Binding SortManualCommand}" ToolTip.Tip="Cards in the order you dragged them"/>
                            <MenuItem Header="{Binding TitleSortText}" Command="{Binding SortTitleCommand}" ToolTip.Tip="Sort by title, a first"/>
                            <MenuItem Header="{Binding NewestSortText}" Command="{Binding SortNewestCommand}" ToolTip.Tip="Newest card first"/>
                            <MenuItem Header="{Binding LongestSortText}" Command="{Binding SortLongestCommand}" ToolTip.Tip="The card that has been in this column longest first"/>
                            <MenuItem Header="{Binding ReverseText}" Command="{Binding ReverseSortCommand}" IsVisible="{Binding IsSorted}"/>
                            <Separator/>
                            <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" IsVisible="{Binding IsColumn}"/>
                            <MenuItem Header="Minimize" Command="{Binding ToggleMinimizedCommand}"/>
                            <MenuItem Header="Remove column…" Command="{Binding AskRemoveCommand}" IsVisible="{Binding IsColumn}"/>
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button DockPanel.Dock="Right" Classes="head" Content="–" Command="{Binding ToggleMinimizedCommand}" ToolTip.Tip="Minimize to a strip"
                              AutomationProperties.Name="{Binding Name, StringFormat='Minimize {0}'}"/>
                      <TextBlock DockPanel.Dock="Right" Classes="dim small" Text="{Binding Count}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                      <Button DockPanel.Dock="Right" Classes="workon colpick" Classes.on="{Binding AllPicked}" Content="{Binding PickText}"
                              Command="{Binding PickCommand}" IsVisible="{Binding HasCards}" Margin="0,0,6,0"
                              ToolTip.Tip="Pick every card showing in this column (click again to unpick them)"/>
                      <TextBlock Classes="listname" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Dim}"
                                 VerticalAlignment="Center" Background="Transparent" Tag="{Binding}"/>
                    </DockPanel>
                    <!-- WOR-0125: Work All (backlog, In Progress) / QA Run All (QA column), asking first above a few -->
                    <Button Classes="bulk" Content="{Binding BulkText}" Command="{Binding BulkCommand}" ToolTip.Tip="{Binding BulkTip}"
                            AutomationProperties.Name="{Binding BulkText}">
                      <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="ShowBulk"/>
                          <Binding Path="IsHeaderPlain"/>
                        </MultiBinding>
                      </Button.IsVisible>
                    </Button>
                    <StackPanel Spacing="6" IsVisible="{Binding ConfirmingBulk}">
                      <TextBlock Text="{Binding BulkQuestion}" TextWrapping="Wrap" FontSize="12"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="Start them" Command="{Binding ConfirmBulkCommand}"/>
                        <Button Content="Cancel" Command="{Binding CancelBulkCommand}"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBox Classes="rename" Text="{Binding EditName}" IsVisible="{Binding IsRenaming}" FontSize="12" Tag="{Binding}"
                             ToolTip.Tip="Enter to save, Esc to leave it as it was. Its cards are renamed with it."/>
                    <StackPanel Spacing="6" IsVisible="{Binding ConfirmingRemove}">
                      <TextBlock Text="{Binding RemoveQuestion}" TextWrapping="Wrap" FontSize="12"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Remove" Command="{Binding RemoveCommand}" Foreground="{DynamicResource Bad}"/>
                        <Button Content="Keep it" Command="{Binding KeepItCommand}"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="bad" Text="{Binding Error}" TextWrapping="Wrap" FontSize="11"
                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Border>
                <!-- WOR-0195: virtualized, so a big column makes and draws the cards on screen, not all of them -->
                  <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.Template>
                      <ControlTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="8"/>
                        </ScrollViewer>
                      </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CardViewModel">
                        <Border Classes="card" Classes.picked="{Binding IsPicked}" Cursor="Hand" ToolTip.Tip="{Binding Description}" Tag="{Binding}" Margin="0,0,0,7">
                          <Border.ContextMenu>
                            <ContextMenu ItemsSource="{Binding MoveTargets}">
                              <ContextMenu.Styles>
                                <Style Selector="MenuItem" x:DataType="vm:MoveTarget">
                                  <Setter Property="Header" Value="{Binding Label}"/>
                                  <Setter Property="Command" Value="{Binding Command}"/>
                                </Style>
                              </ContextMenu.Styles>
                            </ContextMenu>
                          </Border.ContextMenu>
                          <StackPanel Spacing="4">
                            <!-- WOR-0166: the buttons keep their own column; id, star, type and priority wrap in what's left,
                                 so at a narrow column nothing is squeezed into its neighbour -->
                            <Grid ColumnDefinitions="*,Auto">
                              <WrapPanel VerticalAlignment="Center">
                                <TextBlock Classes="dim mono" FontSize="11" Text="{Binding Id}" Margin="0,1,6,1" VerticalAlignment="Center"/>
                                <TextBlock Classes="quality" Classes.zero="{Binding Quality.Zero}" Classes.amber="{Binding Quality.Amber}" Classes.green="{Binding Quality.Green}"
                                           FontSize="11" Text="{Binding Quality.Text}" Margin="0,1,8,1" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Quality.Tip}" AutomationProperties.Name="{Binding Quality.Tip}"/>
                                <Button Classes="workon" Margin="0,1,6,1" VerticalAlignment="Center" Content="✦ Improve" Command="{Binding ImproveCommand}" IsVisible="{Binding ShowImprove}"
                                        AutomationProperties.Name="Improve card" ToolTip.Tip="An agent fills this thin card out: what's wanted, where, done when"/>
                                <Border IsVisible="{Binding ShowsKind}" Classes="kind" Classes.bug="{Binding IsBug}"
                                        CornerRadius="8" Padding="6,0" Margin="0,1,6,1" VerticalAlignment="Center" ToolTip.Tip="Its type">
                                  <TextBlock Text="{Binding Kind}" FontSize="10"/>
                                </Border>
                                <Border IsVisible="{Binding HasPriority}" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="6,0"
                                        Margin="0,1,6,1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="{DynamicResource Accent}"/>
                                </Border>
                              </WrapPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="4,0,0,0">
                                <Button Classes="workon" Content="🧪 Run QA" Command="{Binding RunQaCommand}"
                                        IsVisible="{Binding ShowRunQa}" ToolTip.Tip="An agent checks this card from its How to check section; the card stays in QA"/>
                                <Button Classes="workon" Content="▶ Work on" Command="{Binding WorkOnCommand}"
                                        IsVisible="{Binding CanStart}" ToolTip.Tip="Start an agent on this card"/>
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            <!-- WOR-0172: a chip per blocker still open (or an unknown id, or a cycle); it goes when the blocker reaches QA or done -->
                            <ItemsControl ItemsSource="{Binding BlockerChips}" IsVisible="{Binding HasBlockers}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:BlockerState">
                                  <Border Classes="blocker" ToolTip.Tip="{Binding Text, StringFormat='Blocked by {0}'}" AutomationProperties.Name="{Binding Chip}">
                                    <TextBlock Text="{Binding Chip}" FontSize="10" Foreground="{DynamicResource Warn}"/>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- WOR-0173: Work on a blocked card asks first -->
                            <StackPanel Spacing="4" IsVisible="{Binding AskingBlocked}">
                              <TextBlock Text="{Binding BlockedAsk}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Warn}"/>
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="workon" Content="Start anyway" Command="{Binding StartAnywayCommand}"
                                        ToolTip.Tip="Start an agent on it now; it is told what it waits on and where those cards' reports are"/>
                                <Button Classes="workon" Content="Cancel" Command="{Binding CancelBlockedCommand}"/>
                              </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Labels}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border Classes="label"><TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource LabelInk}"/></Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button IsVisible="{Binding HasAgent}" Command="{Binding OpenAgentCommand}" Classes="agentline"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Open this card's agent">
                              <StackPanel Spacing="1" Classes="agentstate" Classes.working="{Binding Agent.Working, FallbackValue=False}"
                                          Classes.needs="{Binding Agent.NeedsYou, FallbackValue=False}" Classes.done="{Binding Agent.IsDone, FallbackValue=False}"
                                          Classes.failed="{Binding Agent.IsFailed, FallbackValue=False}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <Ellipse Width="7" Height="7" Classes="dot" VerticalAlignment="Center"/>
                                  <TextBlock Classes="state" FontSize="11" Text="{Binding Agent.StateText, StringFormat='agent {0}', FallbackValue=''}"/>
                                </StackPanel>
                                <TextBlock Classes="dim" FontSize="10" Text="{Binding Agent.Activity, FallbackValue=''}" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Agent.Working, FallbackValue=False}"/>
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
              </DockPanel>
            </Border>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button VerticalAlignment="Top" Content="+ Column" Command="{Binding AddColumnCommand}" Margin="0,10,10,10"
              ToolTip.Tip="Add a column before the last (done) column, and name it"/>
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>

    <!-- a card: new, or open to read and edit -->
    <Border Grid.Column="1" Width="400" IsVisible="{Binding IsEditing}" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <DockPanel>
        <!-- WOR-0117: stays at the top left while a long ticket scrolls below -->
        <Button DockPanel.Dock="Top" Content="✕" Command="{Binding Editor.CancelCommand}" HorizontalAlignment="Left"
                Background="Transparent" Padding="8,2" Margin="8,6,0,0" MinHeight="0"
                ToolTip.Tip="Close this card" AutomationProperties.Name="Close card"/>
      <ScrollViewer>
        <StackPanel DataContext="{Binding Editor}" x:DataType="vm:CardEditor" Margin="14" Spacing="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="dim small" Text="{Binding Status}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Classes="mono" FontSize="13"/>
              <TextBlock Classes="quality" Classes.zero="{Binding Quality.Zero}" Classes.amber="{Binding Quality.Amber}" Classes.green="{Binding Quality.Green}"
                         FontSize="13" VerticalAlignment="Center" Text="{Binding Quality.Long}"
                         ToolTip.Tip="{Binding Quality.Tip}" AutomationProperties.Name="{Binding Quality.Tip}"/>
              <Button Classes="workon" Margin="0,1,6,1" VerticalAlignment="Center" Content="✦ Improve" Command="{Binding ImproveCommand}" IsVisible="{Binding ShowImprove}"
                      AutomationProperties.Name="Improve card" ToolTip.Tip="An agent fills this thin card out: what's wanted, where, done when"/>
            </StackPanel>
          </DockPanel>
          <TextBox Text="{Binding Title}" PlaceholderText="Title" FontSize="15" TextWrapping="Wrap"/>
          <!-- WOR-0124: what the card waits on, drawn as an AskUserQuestion is: pick an option and it's done -->
          <Border IsVisible="{Binding ShowDecision}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8"
                  Background="{DynamicResource AccentWash}" Padding="12,10">
            <StackPanel Spacing="6">
              <TextBlock Classes="dim small" Text="Decide"/>
              <TextBlock Text="{Binding DecisionQuestion}" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <!-- WOR-0147: what the question is about, from the card's markdown images -->
              <ItemsControl ItemsSource="{Binding DecisionPictures}" IsVisible="{Binding HasDecisionPictures}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <!-- WOR-0167: a click shows it at full size over the board -->
                  <DataTemplate x:DataType="vm:DecisionPicture">
                    <Button Classes="enlarge" Command="{Binding $parent[ItemsControl].((vm:CardEditor)DataContext).EnlargeCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Click to see it full size" AutomationProperties.Name="Enlarge picture">
                      <Image Source="{Binding Picture}" Stretch="Uniform" MaxHeight="360"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding DecisionChoices}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DecisionChoice">
                    <Button Command="{Binding Command}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{Binding Label}">
                      <StackPanel Spacing="2">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Classes="dim small" Text="{Binding ActionText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                          <!-- WOR-0168: a WrapPanel, not a horizontal StackPanel, so a long label is held to the width left of the action text and wraps -->
                          <WrapPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"/>
                            <TextBlock Text="Recommended" Classes="small" Foreground="{DynamicResource Ok}" IsVisible="{Binding Recommended}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" Classes="dim small" TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding DecisionNotes}" PlaceholderText="Notes to go with your pick, or your own answer…" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="48" MaxHeight="200" views:EnterSends.Command="{Binding AnswerOwnCommand}"/>
                <Button Grid.Column="1" Content="Send" VerticalAlignment="Bottom" Command="{Binding AnswerOwnCommand}"
                        ToolTip.Tip="Send what's typed as your answer: it goes to the agent that asked (or a new one), and the card goes back to In Progress"/>
              </Grid>
              <TextBlock Classes="dim small" Text="{Binding DecisionContext}" TextWrapping="Wrap" IsVisible="{Binding HasDecisionContext}"/>
              <TextBlock Classes="dim small" Text="{Binding DecisionAskedBy}" TextWrapping="Wrap"
                         IsVisible="{Binding DecisionAskedBy, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
          <!-- in For Human Attention with nothing to pick: the fallback, Approve or Send back below -->
          <Border IsVisible="{Binding MissingDecision}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                  Background="{DynamicResource Panel2}" Padding="12,10">
            <StackPanel Spacing="6">
              <TextBlock Classes="small" Foreground="{DynamicResource Accent}" Text="No decision recorded"/>
              <TextBlock Text="Is it right as it stands? Approve it, or say what's wrong and send it back, below." TextWrapping="Wrap" FontWeight="SemiBold"/>
              <TextBlock Classes="dim small" Text="{Binding WhyHere, StringFormat='Why it is here: {0}'}" TextWrapping="Wrap" IsVisible="{Binding HasWhyHere}"/>
              <TextBlock Classes="dim small" TextWrapping="Wrap"
                         Text="Darg asks the agent that moved it for a decision, or drafts one from the card when no agent is around; open the card again to see it."/>
            </StackPanel>
          </Border>
          <TextBox Text="{Binding Description}" PlaceholderText="Description (markdown)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220"
                   IsVisible="{Binding DescriptionOpen}"/>
          <Button Content="▸ Description" IsVisible="{Binding !DescriptionOpen}" Command="{Binding OpenDescriptionCommand}" HorizontalAlignment="Left"
                  Background="Transparent" ToolTip.Tip="Folded while the decision is open: show the card's description"/>
          <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding HasPictures}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><Image Source="{Binding}" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Left"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="AddCardPicture" Content="+ Picture…" HorizontalAlignment="Left"
                  ToolTip.Tip="Copy a picture into the board's images folder and add it to the description as a markdown image"/>
          <TextBox Text="{Binding LabelsText}" PlaceholderText="Labels, comma separated"/>
          <!-- WOR-0172: what this card waits on (edited here), and what waits on it, each a link to the card -->
          <StackPanel Spacing="2">
            <TextBlock Classes="dim small" Text="Blocked by"/>
            <TextBox Text="{Binding BlockedByText}" PlaceholderText="Blocked by: card ids, comma separated (e.g. WOR-0150)"
                     AutomationProperties.Name="Blocked by"
                     ToolTip.Tip="The cards this one waits on, on any of the project's boards. A blocker clears once it is in QA, done or Completed."/>
            <ItemsControl ItemsSource="{Binding BlockedByLinks}" IsVisible="{Binding HasBlockedByLinks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlockerLink">
                  <Button Classes="blocklink" Classes.open="{Binding IsOpen}" Command="{Binding Open}" ToolTip.Tip="Open this card"
                          AutomationProperties.Name="{Binding Id, StringFormat='Open {0}'}">
                    <TextBlock Text="{Binding Text, StringFormat='Blocked by {0}'}" TextWrapping="Wrap" FontSize="12"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding BlocksLinks}" IsVisible="{Binding HasBlocksLinks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BlockerLink">
                  <Button Classes="blocklink" Command="{Binding Open}" ToolTip.Tip="Open this card"
                          AutomationProperties.Name="{Binding Id, StringFormat='Open {0}'}">
                    <TextBlock Text="{Binding Text, StringFormat='Blocks {0}'}" TextWrapping="Wrap" FontSize="12"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Grid ColumnDefinitions="*,8,*">
            <ComboBox Grid.Column="0" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" ToolTip.Tip="Type"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding Priority}" PlaceholderText="Priority" HorizontalAlignment="Stretch"/>
          </Grid>
          <TextBlock Classes="bad" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{Binding IsNew, Converter={x:Static vm:Bools.CreateOrSave}}" Command="{Binding SaveCommand}"/>
            <Button Content="Close" Command="{Binding CancelCommand}"/>
            <Button Content="{Binding WorkOnText}" Command="{Binding WorkOnCommand}" IsVisible="{Binding CanWorkOn}"/>
            <Button Content="🧪 Run QA" Command="{Binding RunQaCommand}" IsVisible="{Binding CanRunQa}" ToolTip.Tip="An agent builds and checks the card from its How to check section and tells you what passed and what didn't. It changes no code and the card stays in QA"/>
            <Button Content="📋 Report" Command="{Binding OpenReportCommand}" IsVisible="{Binding HasReport}" ToolTip.Tip="Open the report written for this card (its decision report, when it's in Needs Attention)"/>
          </StackPanel>
          <!-- WOR-0173: Work on a blocked card asks first -->
          <StackPanel Spacing="6" IsVisible="{Binding AskingBlocked}">
            <TextBlock Text="{Binding BlockedAsk}" TextWrapping="Wrap" Foreground="{DynamicResource Warn}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Start anyway" Command="{Binding StartAnywayCommand}"
                      ToolTip.Tip="Start an agent on it now; it is told what it waits on and where those cards' reports are"/>
              <Button Content="Cancel" Command="{Binding CancelBlockedCommand}"/>
            </StackPanel>
          </StackPanel>
          <!-- WOR-0095: start the QA verdict on a card in QA whose agent is done -->
          <StackPanel Spacing="6" IsVisible="{Binding CanQaVerdict}">
            <TextBlock Classes="dim small" TextWrapping="Wrap" Text="Where does this card go?"/>
            <TextBox Text="{Binding AttentionWhy}" IsVisible="{Binding CanToAttention}" PlaceholderText="Why it needs your attention (optional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                     views:EnterSends.Command="{Binding QaToAttentionCommand}"/>
            <WrapPanel>
              <Button Content="🔔 For human attention" Command="{Binding QaToAttentionCommand}" IsVisible="{Binding CanToAttention}" Margin="0,0,8,4"
                      ToolTip.Tip="Move it to For Human Attention; Darg writes a decision report there"/>
              <Button Content="✓ Done" Command="{Binding QaDoneCommand}" Margin="0,0,8,4" ToolTip.Tip="It's right: move it to the done column"/>
              <TextBlock Classes="dim small" VerticalAlignment="Center" Text="Needs more work: say what's wrong below and Send back"/>
            </WrapPanel>
          </StackPanel>
          <!-- a card in QA that isn't right: what's wrong goes into the card and to an agent that reworks it (WOR-0079) -->
          <StackPanel Spacing="6" IsVisible="{Binding CanSendBack}">
            <TextBlock Classes="dim small" TextWrapping="Wrap" Text="Tried it and it isn't right? Say what's wrong and send it back:"/>
            <TextBox Text="{Binding SendBackNotes}" PlaceholderText="What's wrong, what you expected (Enter sends, Shift+Enter for a new line)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                     views:EnterSends.Command="{Binding SendBackCommand}"/>
            <Button Content="↩ Send back" Command="{Binding SendBackCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="Your notes go into the card under QA notes, the card goes back to In Progress, and an agent starts on them: it reads the How to check section, fixes what you say on top of that work, and brings it back to QA"/>
          </StackPanel>
          <Button Content="✦ Improve this card" Command="{Binding ImproveCommand}" IsVisible="{Binding CanWorkOn}"
                  ToolTip.Tip="An agent reads the card, the note it came from and the code, asks you if the words could mean several things, then fills the description out: what's wanted, where it lives, done when. It doesn't do the work, and the card stays where it is."/>
          <StackPanel Spacing="4" IsVisible="{Binding !!FlowTargets.Count}">
            <TextBlock Classes="dim small" Text="Or run a flow (an agent per role, each handing on to the next):"/>
            <ItemsControl ItemsSource="{Binding FlowTargets}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MoveTarget">
                  <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,8,4"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanDone}" Margin="0,6,0,0">
            <Button Content="✓ Mark done" Command="{Binding DoneCommand}" ToolTip.Tip="Moves it to the board's last column"/>
            <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" Foreground="{DynamicResource Bad}"
                    ToolTip.Tip="Moves its file into the board's .deleted folder (recoverable)"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- making boards: one by hand, or an agent sorting the cards into several -->
    <Border Grid.Column="1" Width="400" IsVisible="{Binding IsMaking}" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel DataContext="{Binding Maker}" x:DataType="vm:BoardMaker" Margin="14" Spacing="10">
          <TextBlock Text="✨ Sort into boards" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Classes="dim" TextWrapping="Wrap"
                     Text="An agent reads every card, works out how best to split them into boards, and asks you before it makes them and moves the cards. IDs stay the same; cards with an agent on them stay put."/>
          <TextBox Text="{Binding Hint}" PlaceholderText="How to sort them (optional): by area, art apart from code…" TextWrapping="Wrap"/>
          <Button Classes="primary" Content="✨ Sort into boards" Command="{Binding SortCommand}"/>

          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,14,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="New board" FontWeight="SemiBold" FontSize="13"/>
              <TextBox Text="{Binding Name}" PlaceholderText="Name" FontSize="15"/>
              <TextBox Text="{Binding Columns}" PlaceholderText="Columns, comma separated"/>
              <TextBlock Classes="dim small" TextWrapping="Wrap" Text="Backlog and Completed are always there. Right-click a card to move it to another board."/>
              <TextBlock Classes="bad" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Create" Command="{Binding CreateCommand}"/>
                <Button Content="Close" Command="{Binding CancelCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
    <!-- WOR-0167: a decision picture at full size, over the whole board; a click anywhere or Escape closes it -->
    <Border x:Name="Lightbox" DataContext="{Binding Editor}" x:DataType="vm:CardEditor" IsVisible="{Binding IsEnlarged, FallbackValue=False}"
            Background="#D8000000" Cursor="Hand" PointerReleased="LightboxReleased" AutomationProperties.Name="Enlarged picture">
      <Grid RowDefinitions="*,Auto" Margin="24">
        <Image Source="{Binding Enlarged}" Stretch="Uniform" StretchDirection="DownOnly"/>
        <TextBlock Grid.Row="1" Text="{Binding EnlargedCaption}" Foreground="#E0FFFFFF" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      </Grid>
    </Border>
    <!-- what is being dragged, drawn over everything, taking no hits -->
    <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
  </Panel>
</UserControl>
