<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Desktop.ViewModels"
             x:Class="Darg.Desktop.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <UserControl.Styles>
    <!-- a column's Pick all: faint until the pointer is on the column, or while the column is all picked -->
    <Style Selector="Border.list:pointerover Button.colpick, Button.colpick.on">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.head">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="Opacity" Value="0.5"/>
    </Style>
    <Style Selector="Border.list:pointerover Button.head"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Button.strip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Padding" Value="0,10"/>
    </Style>
    <!-- a card's type: a red Bug pill; another type a file names, grey -->
    <Style Selector="Border.kind"><Setter Property="Background" Value="{DynamicResource LabelBg}"/></Style>
    <Style Selector="Border.kind TextBlock"><Setter Property="Foreground" Value="{DynamicResource LabelInk}"/></Style>
    <Style Selector="Border.kind.bug"><Setter Property="Background" Value="{DynamicResource BugBg}"/></Style>
    <Style Selector="Border.kind.bug TextBlock"><Setter Property="Foreground" Value="{DynamicResource BugInk}"/></Style>
  </UserControl.Styles>
  <Panel>
  <Grid ColumnDefinitions="*,Auto">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" MinWidth="140" Margin="0,0,6,0"/>
        <Button DockPanel.Dock="Left" Content="+ Board" Command="{Binding NewBoardCommand}" Margin="0,0,12,0"
                ToolTip.Tip="Make a new board, or have an agent sort the cards into boards"/>
        <Button DockPanel.Dock="Right" Classes="primary" Content="+ Card" Command="{Binding NewCardCommand}" Margin="12,0,0,0"/>
        <CheckBox DockPanel.Dock="Right" Content="Show completed" IsChecked="{Binding ShowCompleted}" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Classes="dim" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
          <TextBlock Text="{Binding PickedText}" IsVisible="{Binding HasPicked}" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
          <Button Classes="primary" Content="{Binding WorkOnPickedText}" Command="{Binding WorkOnPickedCommand}" IsVisible="{Binding CanWorkOnPicked}"
                  ToolTip.Tip="Start an agent on each picked card, all at once in the project's folder; each is told which others are running beside it. Cards that already have an agent are skipped."/>
          <Button Content="Unpick" Command="{Binding ClearPickedCommand}" IsVisible="{Binding HasPicked}" ToolTip.Tip="Unpick every card (Esc)"/>
          <Button Content="Pick all" Command="{Binding PickAllCommand}"
                  ToolTip.Tip="Pick every card showing (Ctrl+A). A column's own Pick all picks just that column; Ctrl- or Shift-click picks one at a time."/>
        </StackPanel>
        <TextBox Text="{Binding Filter}" PlaceholderText="Filter by ID, title or description…" MaxWidth="460" HorizontalAlignment="Left" MinWidth="60"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8,14,3">
      <ItemsControl ItemsSource="{Binding Labels}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LabelChip">
            <Button Classes="chip" Classes.any="{Binding IsAny}" Classes.all="{Binding IsAll}" Content="{Binding Shown}" Command="{Binding ClickCommand}"
                    ToolTip.Tip="Click: any of these labels. Double-click: must have this one."/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal">
      <ItemsControl ItemsSource="{Binding Lists}" Margin="10">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ListViewModel">
            <Panel>
            <!-- minimized: a narrow strip with its name running down it; a click opens it, cards still drop on it -->
            <Border Width="38" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                    Tag="{Binding Id}" Classes="list" IsVisible="{Binding IsMinimized}">
              <Button Classes="strip" Command="{Binding ToggleMinimizedCommand}" ToolTip.Tip="{Binding Name, StringFormat='Open {0}'}"
                      AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="dim small" Text="{Binding Count}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                  <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Top">
                    <LayoutTransformControl.LayoutTransform><RotateTransform Angle="90"/></LayoutTransformControl.LayoutTransform>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Dim}"/>
                  </LayoutTransformControl>
                </DockPanel>
              </Button>
            </Border>
            <Border Width="290" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                    Tag="{Binding Id}" Classes="list" IsVisible="{Binding IsOpen}">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,6">
                  <StackPanel Spacing="6">
                    <DockPanel IsVisible="{Binding IsHeaderPlain}">
                      <Button DockPanel.Dock="Right" Classes="head" Content="⋯" ToolTip.Tip="Rename, minimize or remove this list"
                              AutomationProperties.Name="{Binding Name, StringFormat='{}{0} menu'}">
                        <Button.Flyout>
                          <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Wrap up into stories…" Command="{Binding WrapUpCommand}" IsVisible="{Binding IsDoneColumn}"
                                      ToolTip.Tip="An agent groups these cards into stories (a doc each and a Story card here), asks you, then moves the cards to Completed"/>
                            <MenuItem Header="Rename" Command="{Binding StartRenameCommand}" IsVisible="{Binding IsColumn}"/>
                            <MenuItem Header="Minimize" Command="{Binding ToggleMinimizedCommand}"/>
                            <MenuItem Header="Remove column…" Command="{Binding AskRemoveCommand}" IsVisible="{Binding IsColumn}"/>
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button DockPanel.Dock="Right" Classes="head" Content="–" Command="{Binding ToggleMinimizedCommand}" ToolTip.Tip="Minimize to a strip"
                              AutomationProperties.Name="{Binding Name, StringFormat='Minimize {0}'}"/>
                      <TextBlock DockPanel.Dock="Right" Classes="dim small" Text="{Binding Count}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                      <Button DockPanel.Dock="Right" Classes="workon colpick" Classes.on="{Binding AllPicked}" Content="{Binding PickText}"
                              Command="{Binding PickCommand}" IsVisible="{Binding HasCards}" Margin="0,0,6,0"
                              ToolTip.Tip="Pick every card showing in this column (click again to unpick them)"/>
                      <TextBlock Classes="listname" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Dim}"
                                 VerticalAlignment="Center" Background="Transparent" Tag="{Binding}"/>
                    </DockPanel>
                    <TextBox Classes="rename" Text="{Binding EditName}" IsVisible="{Binding IsRenaming}" FontSize="12" Tag="{Binding}"
                             ToolTip.Tip="Enter to save, Esc to leave it as it was. Its cards are renamed with it."/>
                    <StackPanel Spacing="6" IsVisible="{Binding ConfirmingRemove}">
                      <TextBlock Text="{Binding RemoveQuestion}" TextWrapping="Wrap" FontSize="12"/>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Remove" Command="{Binding RemoveCommand}" Foreground="{DynamicResource Bad}"/>
                        <Button Content="Keep it" Command="{Binding KeepItCommand}"/>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="bad" Text="{Binding Error}" TextWrapping="Wrap" FontSize="11"
                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Cards}" Margin="8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CardViewModel">
                        <Border Classes="card" Classes.picked="{Binding IsPicked}" Cursor="Hand" ToolTip.Tip="{Binding Description}" Tag="{Binding}">
                          <Border.ContextMenu>
                            <ContextMenu ItemsSource="{Binding MoveTargets}">
                              <ContextMenu.Styles>
                                <Style Selector="MenuItem" x:DataType="vm:MoveTarget">
                                  <Setter Property="Header" Value="{Binding Label}"/>
                                  <Setter Property="Command" Value="{Binding Command}"/>
                                </Style>
                              </ContextMenu.Styles>
                            </ContextMenu>
                          </Border.ContextMenu>
                          <StackPanel Spacing="4">
                            <DockPanel>
                              <Button DockPanel.Dock="Right" Classes="workon" Content="▶ Work on" Command="{Binding WorkOnCommand}"
                                      IsVisible="{Binding !HasAgent}" ToolTip.Tip="Start an agent on this card"/>
                              <Border DockPanel.Dock="Right" IsVisible="{Binding HasPriority}" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="6,0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="{DynamicResource Accent}"/>
                              </Border>
                              <Border DockPanel.Dock="Right" IsVisible="{Binding ShowsKind}" Classes="kind" Classes.bug="{Binding IsBug}"
                                      CornerRadius="8" Padding="6,0" Margin="0,0,6,0" ToolTip.Tip="Its type">
                                <TextBlock Text="{Binding Kind}" FontSize="10"/>
                              </Border>
                              <TextBlock Classes="dim mono" FontSize="11" Text="{Binding Id}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Labels}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border Classes="label"><TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource LabelInk}"/></Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button IsVisible="{Binding HasAgent}" Command="{Binding OpenAgentCommand}" Classes="agentline"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ToolTip.Tip="Open this card's agent">
                              <StackPanel Spacing="1" Classes="agentstate" Classes.working="{Binding Agent.Working, FallbackValue=False}"
                                          Classes.needs="{Binding Agent.NeedsYou, FallbackValue=False}" Classes.done="{Binding Agent.IsDone, FallbackValue=False}"
                                          Classes.failed="{Binding Agent.IsFailed, FallbackValue=False}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <Ellipse Width="7" Height="7" Classes="dot" VerticalAlignment="Center"/>
                                  <TextBlock Classes="state" FontSize="11" Text="{Binding Agent.StateText, StringFormat='agent {0}', FallbackValue=''}"/>
                                </StackPanel>
                                <TextBlock Classes="dim" FontSize="10" Text="{Binding Agent.Activity, FallbackValue=''}" TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding Agent.Working, FallbackValue=False}"/>
                              </StackPanel>
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button VerticalAlignment="Top" Content="+ Column" Command="{Binding AddColumnCommand}" Margin="0,10,10,10"
              ToolTip.Tip="Add a column before the last (done) column, and name it"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>

    <!-- a card: new, or open to read and edit -->
    <Border Grid.Column="1" Width="400" IsVisible="{Binding IsEditing}" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel DataContext="{Binding Editor}" x:DataType="vm:CardEditor" Margin="14" Spacing="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="dim small" Text="{Binding Status}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" Classes="mono" FontSize="13"/>
          </DockPanel>
          <TextBox Text="{Binding Title}" PlaceholderText="Title" FontSize="15" TextWrapping="Wrap"/>
          <TextBox Text="{Binding Description}" PlaceholderText="Description (markdown)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220"/>
          <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding HasPictures}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate><Image Source="{Binding}" Stretch="Uniform" MaxHeight="300" HorizontalAlignment="Left"/></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="AddCardPicture" Content="+ Picture…" HorizontalAlignment="Left"
                  ToolTip.Tip="Copy a picture into the board's images folder and add it to the description as a markdown image"/>
          <TextBox Text="{Binding LabelsText}" PlaceholderText="Labels, comma separated"/>
          <Grid ColumnDefinitions="*,8,*">
            <ComboBox Grid.Column="0" ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" ToolTip.Tip="Type"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding Priority}" PlaceholderText="Priority" HorizontalAlignment="Stretch"/>
          </Grid>
          <TextBlock Classes="bad" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{Binding IsNew, Converter={x:Static vm:Bools.CreateOrSave}}" Command="{Binding SaveCommand}"/>
            <Button Content="Close" Command="{Binding CancelCommand}"/>
            <Button Content="▶ Work on this" Command="{Binding WorkOnCommand}" IsVisible="{Binding CanWorkOn}"/>
          </StackPanel>
          <Button Content="✦ Improve this card" Command="{Binding ImproveCommand}" IsVisible="{Binding CanWorkOn}"
                  ToolTip.Tip="An agent reads the card, the note it came from and the code, asks you if the words could mean several things, then fills the description out: what's wanted, where it lives, done when. It doesn't do the work, and the card stays where it is."/>
          <StackPanel Spacing="4" IsVisible="{Binding !!FlowTargets.Count}">
            <TextBlock Classes="dim small" Text="Or run a flow (an agent per role, each handing on to the next):"/>
            <ItemsControl ItemsSource="{Binding FlowTargets}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MoveTarget">
                  <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,8,4"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanDone}" Margin="0,6,0,0">
            <Button Content="✓ Mark done" Command="{Binding DoneCommand}" ToolTip.Tip="Moves it to the board's last column"/>
            <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}" Foreground="{DynamicResource Bad}"
                    ToolTip.Tip="Moves its file into the board's .deleted folder (recoverable)"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- making boards: one by hand, or an agent sorting the cards into several -->
    <Border Grid.Column="1" Width="400" IsVisible="{Binding IsMaking}" Background="{DynamicResource Panel}"
            BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel DataContext="{Binding Maker}" x:DataType="vm:BoardMaker" Margin="14" Spacing="10">
          <TextBlock Text="✨ Sort into boards" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Classes="dim" TextWrapping="Wrap"
                     Text="An agent reads every card, works out how best to split them into boards, and asks you before it makes them and moves the cards. IDs stay the same; cards with an agent on them stay put."/>
          <TextBox Text="{Binding Hint}" PlaceholderText="How to sort them (optional): by area, art apart from code…" TextWrapping="Wrap"/>
          <Button Classes="primary" Content="✨ Sort into boards" Command="{Binding SortCommand}"/>

          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,14,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="New board" FontWeight="SemiBold" FontSize="13"/>
              <TextBox Text="{Binding Name}" PlaceholderText="Name" FontSize="15"/>
              <TextBox Text="{Binding Columns}" PlaceholderText="Columns, comma separated"/>
              <TextBlock Classes="dim small" TextWrapping="Wrap" Text="Backlog and Completed are always there. Right-click a card to move it to another board."/>
              <TextBlock Classes="bad" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Create" Command="{Binding CreateCommand}"/>
                <Button Content="Close" Command="{Binding CancelCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
    <!-- what is being dragged, drawn over everything, taking no hits -->
    <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
  </Panel>
</UserControl>
