<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Desktop.ViewModels"
             xmlns:views="using:Darg.Desktop.Views"
             x:Class="Darg.Desktop.Views.ProjectView"
             x:DataType="vm:ProjectViewModel">
  <Grid ColumnDefinitions="60,*">
    <Border Background="#111317" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center">
        <ToggleButton Classes="rail" IsChecked="{Binding OnBoard, Mode=OneWay}" IsVisible="{Binding Board, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Board" ToolTip.Tip="Board">
          <StackPanel><TextBlock Text="▦" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Board" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnNotes, Mode=OneWay}" IsVisible="{Binding Notes, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Notes" ToolTip.Tip="Notes wall">
          <StackPanel><TextBlock Text="▤" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Notes" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnDocs, Mode=OneWay}" IsVisible="{Binding Docs, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Docs" ToolTip.Tip="Docs">
          <StackPanel><TextBlock Text="❏" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Docs" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnAgents, Mode=OneWay}" IsVisible="{Binding Agents, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Agents" ToolTip.Tip="Agents">
          <StackPanel><TextBlock Text="✦" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Agents" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnArtifacts, Mode=OneWay}" IsVisible="{Binding Artifacts, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Artifacts" ToolTip.Tip="Artifacts: pages agents made, that can send back to them">
          <StackPanel><TextBlock Text="◧" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Artifacts" FontSize="9" HorizontalAlignment="Center" Margin="-8,0"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnMistakes, Mode=OneWay}" IsVisible="{Binding Mistakes, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Mistakes" ToolTip.Tip="Mistakes: what agents got wrong here, counted by kind">
          <StackPanel><TextBlock Text="✗" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Mistakes" FontSize="9" HorizontalAlignment="Center" Margin="-8,0"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnCode, Mode=OneWay}" IsVisible="{Binding Code, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Code" ToolTip.Tip="Code">
          <StackPanel><TextBlock Text="{}{ }" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="Code" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnHub, Mode=OneWay}" IsVisible="{Binding Hub, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="GitHub" ToolTip.Tip="GitHub: pull requests, issues, CI">
          <StackPanel><TextBlock Text="⎇" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="GitHub" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnPreview, Mode=OneWay}" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Command="{Binding OpenCommand}" CommandParameter="Preview" ToolTip.Tip="Preview: the site, live from its dev server">
          <StackPanel><TextBlock Text="◉" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Site" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
        <ToggleButton Classes="rail" IsChecked="{Binding OnTerminal, Mode=OneWay}" IsVisible="{Binding UsesTerminal}"
                      Command="{Binding OpenCommand}" CommandParameter="Terminal" ToolTip.Tip="Terminal">
          <StackPanel><TextBlock Text="▶" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="Term" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
        </ToggleButton>
      </StackPanel>
    </Border>

    <Panel Grid.Column="1">
      <views:BoardView DataContext="{Binding Board}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnBoard}"/>
      <views:NotesView DataContext="{Binding Notes}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnNotes}"/>
      <views:CodeView DataContext="{Binding Code}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnCode}"/>
      <views:GitHubView DataContext="{Binding Hub}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnHub}"/>
      <views:DocsView DataContext="{Binding Docs}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnDocs}"/>
      <views:AgentsView DataContext="{Binding Agents}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnAgents}"/>
      <views:ArtifactsView DataContext="{Binding Artifacts}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnArtifacts}"/>
      <views:MistakesView DataContext="{Binding Mistakes}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnMistakes}"/>
      <views:PreviewView DataContext="{Binding Preview}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnPreview}"/>
      <views:ConsolesView DataContext="{Binding Consoles}" IsVisible="{Binding $parent[views:ProjectView].((vm:ProjectViewModel)DataContext).OnTerminal}"/>
    </Panel>
  </Grid>
</UserControl>
