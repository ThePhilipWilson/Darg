<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Desktop.ViewModels"
             xmlns:views="using:Darg.Desktop.Views"
             x:Class="Darg.Desktop.Views.DesignView"
             x:DataType="vm:DesignViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.part">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.part">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <!-- a card's row: the whole row opens the card once it's made -->
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="4,8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="TextBlock.quality"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></Style>
    <Style Selector="TextBlock.quality.zero"><Setter Property="Foreground" Value="{DynamicResource Zero}"/></Style>
    <Style Selector="TextBlock.quality.amber"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></Style>
    <Style Selector="TextBlock.quality.green"><Setter Property="Foreground" Value="{DynamicResource Ok}"/></Style>
    <Style Selector="TextBlock.blocker"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></Style>
    <Style Selector="TextBlock.blocker.bad"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></Style>
    <Style Selector="Border.column">
      <Setter Property="Background" Value="{DynamicResource LabelBg}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,1"/>
    </Style>
    <Style Selector="Border.column.done"><Setter Property="Background" Value="{DynamicResource AccentWash}"/></Style>
    <Style Selector="TextBlock.dropped"><Setter Property="TextDecorations" Value="Strikethrough"/></Style>
    <!-- a question a Needs you row jumped to is lit (WOR-0200) -->
    <Style Selector="Border.question">
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.question.lit">
      <Setter Property="BorderBrush" Value="{DynamicResource Warn}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBlock.planner"><Setter Property="Foreground" Value="{DynamicResource Info}"/></Style>
    <Style Selector="TextBlock.planner.waiting"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- Goals, Not doing and Design: markdown to read, ✎ Edit for a box with Save and Cancel -->
    <DataTemplate DataType="vm:PlanTextPart">
      <Border Classes="part">
        <StackPanel Spacing="6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
              <Button Content="✎ Edit" Command="{Binding EditCommand}" IsVisible="{Binding Reading}" AutomationProperties.Name="{Binding Label, StringFormat='Edit {0}'}"/>
              <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding Editing}" AutomationProperties.Name="{Binding Label, StringFormat='Save {0}'}"/>
              <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding Editing}"/>
            </StackPanel>
            <TextBlock Classes="part" Text="{Binding Label}" VerticalAlignment="Center"/>
          </DockPanel>
          <views:MarkdownView Markdown="{Binding Markdown}" IsVisible="{Binding Reading}"/>
          <TextBlock Classes="dim" Text="{Binding Hint}" TextWrapping="Wrap">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="IsEmpty"/>
                <Binding Path="Reading"/>
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
          <TextBox Text="{Binding Draft}" IsVisible="{Binding Editing}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="520"
                   FontFamily="Consolas,Menlo,monospace" FontSize="13" PlaceholderText="{Binding Hint}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid ColumnDefinitions="300,*,Auto" RowDefinitions="*,Auto">
    <!-- the plans as a tree: a project plan with its feature plans under it -->
    <Border Grid.RowSpan="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,10,8,6">
          <Button DockPanel.Dock="Right" Content="⟳" Command="{Binding RefreshCommand}" ToolTip.Tip="Read the plans and the boards again" AutomationProperties.Name="Refresh plans"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Plans" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Folder}" Classes="dim small" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}"/>
          </StackPanel>
        </DockPanel>
        <!-- + Plan (WOR-0176): a line, and the planner drafts the whole plan for you to react to -->
        <StackPanel DockPanel.Dock="Top" Margin="12,0,8,8" Spacing="6" IsVisible="{Binding CanPlan}">
          <TextBox Text="{Binding Idea}" PlaceholderText="A line to plan: a feature, or a whole project" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="36" MaxHeight="120" views:EnterSends.Command="{Binding StartPlanCommand}" AutomationProperties.Name="Plan idea"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Content="+ Plan" Command="{Binding StartPlanCommand}" AutomationProperties.Name="Start plan"
                    ToolTip.Tip="A planner agent drafts every part of the plan from your line, its open calls as questions for you, and writes it here"/>
            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" FontSize="12" MinHeight="0" Padding="8,3" Margin="0,0,6,0"
                      AutomationProperties.Name="Plan kind" ToolTip.Tip="A feature plan proposes cards; a project plan lists features"/>
          </DockPanel>
        </StackPanel>
        <TreeView ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}" Background="Transparent">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:PlanNode">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
              <Setter Property="MinHeight" Value="28"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:PlanNode" ItemsSource="{Binding Children}">
              <DockPanel ToolTip.Tip="{Binding Tip}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" Classes="dim small" Margin="8,0,6,0" VerticalAlignment="Center"/>
                <!-- what waits on Philip here and in the plans under it (WOR-0200) -->
                <TextBlock DockPanel.Dock="Right" Text="{Binding NeedsText}" Foreground="{DynamicResource Warn}" Classes="small" FontWeight="SemiBold"
                           Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasNeeds}" ToolTip.Tip="{Binding NeedsTip}"/>
                <Border DockPanel.Dock="Right" Classes="column" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasMark}">
                  <TextBlock Text="{Binding Mark}" Classes="small"/>
                </Border>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Classes.dropped="{Binding Dropped}"/>
              </DockPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Border>

    <Panel Grid.Column="1">
      <DockPanel IsVisible="{Binding HasPage}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Content="{Binding Page.BoardText, FallbackValue=''}" Command="{Binding Page.OpenBoardCommand, FallbackValue={x:Null}}"
                      IsVisible="{Binding Page.HasBoard, FallbackValue=False}" ToolTip.Tip="Show the plan's story board"/>
              <Button Content="Open file" Command="{Binding OpenFileCommand}" ToolTip.Tip="{Binding Page.File, FallbackValue=''}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <SelectableTextBlock Text="{Binding Page.Title, FallbackValue=''}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <!-- how far it has got (WOR-0200): its state, features and cards, and what its planner is doing now -->
              <WrapPanel>
                <Border Classes="column" Classes.done="{Binding Page.Built, FallbackValue=False}" Margin="0,1,8,1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Page.State, FallbackValue=''}" Classes="small"/>
                </Border>
                <TextBlock Text="{Binding Page.Summary, FallbackValue=''}" Classes="dim small" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding PlannerText}" Classes="small planner" Classes.waiting="{Binding PlannerWaiting}" VerticalAlignment="Center"
                           IsVisible="{Binding HasPlanner}"/>
              </WrapPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Needs you (WOR-0200): what waits on Philip in this plan and the plans under it; only there when something does -->
        <Border x:Name="NeedsStrip" DockPanel.Dock="Top" IsVisible="{Binding Page.HasNeeds, FallbackValue=False}" Margin="18,12,18,0" Padding="12,8"
                CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Warn}" Background="{DynamicResource Panel}">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Page.NeedsHeading, FallbackValue=''}" FontWeight="SemiBold" Foreground="{DynamicResource Warn}"/>
            <ScrollViewer MaxHeight="190">
              <ItemsControl ItemsSource="{Binding Page.Needs, FallbackValue={x:Null}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PlanNeedRow">
                    <Button Classes="row" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Text}" Padding="2,5">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Classes="column" Margin="8,0,0,0" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Kind}" Classes="small"/>
                        </Border>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- the page fills the width it's given (Philip, 2026-11-22: no empty strip on a wide window) -->
        <ScrollViewer x:Name="PageScroll">
          <StackPanel x:Name="PageParts" Margin="18,14" Spacing="12">
            <views:MarkdownView Markdown="{Binding Page.Intro, FallbackValue=''}" IsVisible="{Binding Page.HasIntro, FallbackValue=False}"/>
            <ContentControl Content="{Binding Page.Goals, FallbackValue={x:Null}}"/>
            <ContentControl Content="{Binding Page.NotDoing, FallbackValue={x:Null}}"/>

            <!-- the questions only Philip can answer: tap an option and it's written as the Answer line -->
            <Border Classes="part">
              <StackPanel Spacing="8">
                <TextBlock Classes="part" Text="{Binding Page.QuestionsHeading, FallbackValue='Questions'}"/>
                <TextBlock Classes="dim" Text="No questions: nothing in this plan waits on a choice." IsVisible="{Binding !Page.HasQuestions, FallbackValue=False}"/>
                <ItemsControl ItemsSource="{Binding Page.Questions, FallbackValue={x:Null}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanQuestionRow">
                      <Border Classes="question" Classes.lit="{Binding Highlighted}" CornerRadius="6" Padding="10,8" Background="{DynamicResource Bg}">
                        <StackPanel Spacing="6">
                          <SelectableTextBlock Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Context}" Classes="dim small" TextWrapping="Wrap" IsVisible="{Binding HasContext}"/>
                          <DockPanel IsVisible="{Binding ByAgent}">
                            <Button DockPanel.Dock="Right" Content="Keep" Command="{Binding KeepCommand}" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Classes="primary" AutomationProperties.Name="Keep agent's choice"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Warn}" Text="{Binding DecidedText}"/>
                          </DockPanel>
                          <DockPanel IsVisible="{Binding Answered}">
                            <Button DockPanel.Dock="Right" Content="{Binding Changing, Converter={x:Static views:DesignView.ChangeLabel}}" Command="{Binding ChangeCommand}"
                                    Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Change answer"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Text="{Binding Answer, StringFormat='Answer: {0}'}"/>
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding Asking}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PlanOptionRow">
                                <Button Command="{Binding PickCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Classes.primary="{Binding Recommended}" AutomationProperties.Name="{Binding Label}">
                                  <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Classes="small" TextWrapping="Wrap" Opacity="0.85" IsVisible="{Binding HasDescription}"/>
                                  </StackPanel>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding Asking}">
                            <TextBox Text="{Binding OwnAnswer}" PlaceholderText="Or type your own answer…" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="36" MaxHeight="160" views:EnterSends.Command="{Binding SendOwnCommand}"/>
                            <Button Grid.Column="1" Content="Answer" VerticalAlignment="Bottom" Command="{Binding SendOwnCommand}"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <ContentControl Content="{Binding Page.Design, FallbackValue={x:Null}}"/>

            <!-- a project plan's features (WOR-0179): each with its own plan's state and progress once there is one; the ticked
                 ones without get a planner each, parent set to this plan -->
            <Border Classes="part" IsVisible="{Binding Page.ShowFeatures, FallbackValue=False}">
              <StackPanel Spacing="4">
                <TextBlock Classes="part" Text="Features"/>
                <TextBlock Classes="dim" Text="No features listed yet." IsVisible="{Binding !Page.HasFeatures, FallbackValue=False}"/>
                <ItemsControl ItemsSource="{Binding Page.Features, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanFeatureRow">
                     <DockPanel>
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Ticked}" IsVisible="{Binding Proposed}" VerticalAlignment="Top" Margin="0,2,0,0"
                                ToolTip.Tip="Draft a plan for this feature" AutomationProperties.Name="{Binding Title, StringFormat='Plan {0}'}"/>
                      <Button Classes="row" Command="{Binding OpenCommand}" IsHitTestVisible="{Binding HasPlan}" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Title}">
                        <StackPanel Spacing="2">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="8,0,0,0">
                              <Border Classes="column" IsVisible="{Binding HasPlan}">
                                <TextBlock Text="{Binding State}" Classes="small"/>
                              </Border>
                              <TextBlock Text="{Binding State}" Foreground="{DynamicResource Info}" Classes="small" VerticalAlignment="Center" IsVisible="{Binding Drafting}"/>
                              <TextBlock Text="{Binding State}" Classes="dim small" VerticalAlignment="Center" IsVisible="{Binding Proposed}"/>
                              <TextBlock Text="plan ›" Classes="dim small" IsVisible="{Binding HasPlan}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          </DockPanel>
                          <TextBlock Text="{Binding Description}" Classes="dim small" TextWrapping="Wrap" IsVisible="{Binding HasDescription}"/>
                        </StackPanel>
                      </Button>
                     </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Page.FeaturesOpenText, FallbackValue=''}" Classes="blocker small" TextWrapping="Wrap"
                           IsVisible="{Binding Page.HasFeaturesOpenQuestions, FallbackValue=False}"/>
                <Button HorizontalAlignment="Left" Content="{Binding Page.MakeFeaturesText, FallbackValue=''}" Command="{Binding Page.MakeFeaturesCommand, FallbackValue={x:Null}}"
                        IsEnabled="{Binding Page.CanMakeFeatures, FallbackValue=False}" IsVisible="{Binding Page.HasProposedFeatures, FallbackValue=False}"
                        AutomationProperties.Name="Draft feature plans" ToolTip.Tip="Start a planner on each ticked feature: it drafts the feature's plan, under this one"/>
              </StackPanel>
            </Border>

            <!-- the cards: proposed ones with their ticket score, made ones as the board has them now -->
            <Border Classes="part" IsVisible="{Binding Page.ShowCards, FallbackValue=False}">
              <StackPanel Spacing="4">
                <TextBlock Classes="part" Text="Cards"/>
                <TextBlock Classes="dim" Text="No cards proposed yet." IsVisible="{Binding !Page.HasCards, FallbackValue=False}"/>
                <ItemsControl ItemsSource="{Binding Page.Cards, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanCardRow">
                     <DockPanel>
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Ticked}" IsVisible="{Binding Proposed}" VerticalAlignment="Top" Margin="0,2,0,0"
                                ToolTip.Tip="Make this card" AutomationProperties.Name="{Binding Title, StringFormat='Make {0}'}"/>
                      <Button Classes="row" Command="{Binding OpenCommand}" IsHitTestVisible="{Binding Made}" ToolTip.Tip="{Binding Tip}"
                              AutomationProperties.Name="{Binding Heading}">
                        <StackPanel Spacing="3">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="8,0,0,0">
                              <TextBlock Text="{Binding Agent}" Foreground="{DynamicResource Info}" Classes="small" VerticalAlignment="Center" IsVisible="{Binding HasAgent}"/>
                              <Border Classes="column" Classes.done="{Binding IsDone}" IsVisible="{Binding Made}">
                                <TextBlock Text="{Binding Column}" Classes="small"/>
                              </Border>
                              <TextBlock Text="proposed" Classes="dim small" VerticalAlignment="Center" IsVisible="{Binding Proposed}"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Classes="quality" Classes.zero="{Binding Quality.Zero, FallbackValue=False}"
                                       Classes.amber="{Binding Quality.Amber, FallbackValue=False}" Classes.green="{Binding Quality.Green, FallbackValue=False}"
                                       Text="★" Margin="0,0,6,0" IsVisible="{Binding HasQuality}" ToolTip.Tip="{Binding Quality.Tip, FallbackValue=''}"/>
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          </DockPanel>
                          <TextBlock Text="{Binding Description}" Classes="dim small" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                          <TextBlock Text="{Binding Where, StringFormat='Where: {0}'}" Classes="dim small" TextWrapping="Wrap" IsVisible="{Binding HasWhere}"/>
                          <TextBlock Text="{Binding Done, StringFormat='Done when: {0}'}" Classes="dim small" TextWrapping="Wrap" IsVisible="{Binding HasDone}"/>
                          <TextBlock Text="{Binding Blockers}" Classes="blocker small" Classes.bad="{Binding BlockerWarning}" TextWrapping="Wrap" IsVisible="{Binding HasBlockers}"/>
                        </StackPanel>
                      </Button>
                     </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- WOR-0177: one press makes the ticked cards; questions still open are listed and need a second press -->
                <TextBlock Text="{Binding Page.OpenQuestionsText, FallbackValue=''}" Classes="blocker small" TextWrapping="Wrap"
                           IsVisible="{Binding Page.HasOpenQuestions, FallbackValue=False}"/>
                <Button HorizontalAlignment="Left" Content="{Binding Page.MakeText, FallbackValue=''}" Command="{Binding Page.MakeCardsCommand, FallbackValue={x:Null}}"
                        IsEnabled="{Binding Page.CanMake, FallbackValue=False}" IsVisible="{Binding Page.HasProposed, FallbackValue=False}"
                        AutomationProperties.Name="Make cards" ToolTip.Tip="Make the ticked cards on the plan's story board, blockers and all"/>
              </StackPanel>
            </Border>

            <!-- what has happened since: the made cards' reports, read each time, never written into the plan -->
            <Border Classes="part">
              <StackPanel Spacing="4">
                <TextBlock Classes="part" Text="Log"/>
                <TextBlock Classes="dim" Text="Nothing yet: the plan's cards' reports show here as they come in." TextWrapping="Wrap" IsVisible="{Binding !Page.HasLog, FallbackValue=False}"/>
                <ItemsControl ItemsSource="{Binding Page.Log, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanLogRow">
                      <Button Classes="row" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Text}">
                        <StackPanel>
                          <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Meta}" Classes="dim small"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
      <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap"
                 IsVisible="{Binding Empty}" Text="{Binding EmptyText}"/>
      <TextBlock Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap"
                 IsVisible="{Binding IsDrafting}" Text="{Binding DraftingText}"/>
    </Panel>

    <!-- the planner's chat beside the page (WOR-0176): the agent that drafted this plan, to ask for changes -->
    <Border Grid.Column="2" Width="400" IsVisible="{Binding ShowChat}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Planner.Name, FallbackValue='Planner'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Planner.StateText, FallbackValue=''}" Classes="dim small" IsVisible="{Binding HasPlanner}"/>
            <TextBlock Classes="dim small" TextWrapping="Wrap" IsVisible="{Binding NoPlanner}"
                       Text="No planner on this plan yet. A message here starts one that reads the plan first."/>
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
          <StackPanel Spacing="6">
            <DockPanel>
              <TextBlock Text="Change" Classes="dim small" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox ItemsSource="{Binding ChangeParts}" SelectedItem="{Binding ChangePart}" FontSize="12" MinHeight="0" Padding="8,3"
                        AutomationProperties.Name="Part to change" ToolTip.Tip="Pick a part and only that part changes: anything else the planner touches is put back"/>
            </DockPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding Ask}" PlaceholderText="Ask the planner to change the plan…" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="36" MaxHeight="160" views:EnterSends.Command="{Binding AskPlannerCommand}" AutomationProperties.Name="Ask the planner"/>
              <Button Grid.Column="1" Classes="primary" Content="Send" VerticalAlignment="Bottom" Command="{Binding AskPlannerCommand}" AutomationProperties.Name="Send to planner"/>
            </Grid>
          </StackPanel>
        </Border>
        <ScrollViewer x:Name="ChatScroll">
          <ItemsControl ItemsSource="{Binding Planner.Items, FallbackValue={x:Null}}" Margin="12,10">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
      <TextBlock Classes="dim small" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}"/>
    </Border>
  </Grid>
</UserControl>
