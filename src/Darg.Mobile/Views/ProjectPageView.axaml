<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Mobile.ViewModels"
             xmlns:views="using:Darg.Mobile.Views"
             x:Class="Darg.Mobile.Views.ProjectPageView"
             x:DataType="vm:ProjectPageViewModel"
             x:Name="Root">
  <DockPanel>
    <!-- the project's phone sections, along the bottom where a thumb reaches -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <ItemsControl ItemsSource="{Binding Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SectionTab">
            <Button Classes="tab" Command="{Binding #Root.((vm:ProjectPageViewModel)DataContext).PickCommand}" CommandParameter="{Binding}" Classes.on="{Binding On}"
                    AutomationProperties.Name="{Binding Section.Name}">
              <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Section.Glyph}" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Section.Name}" FontSize="12" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <Panel>
      <!-- Home, Notes, Docs and Reports (AND-0008), Agents (AND-0005) -->
      <ContentControl Content="{Binding Content}" IsVisible="{Binding HasContent}"/>
      <!-- the Board section (AND-0004) -->
      <views:BoardSectionView DataContext="{Binding Board}" IsVisible="{Binding #Root.((vm:ProjectPageViewModel)DataContext).ShowsBoard}"/>
      <!-- the sections whose cards haven't landed yet -->
      <StackPanel Margin="20" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding ShowsPlaceholder}">
        <TextBlock Text="{Binding Section.Glyph}" FontSize="40" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Section.Name}" Classes="title" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Placeholder}" Classes="dim" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
      <!-- Fettle (AND-0007), over whatever section shows, bottom right where a thumb reaches; on the board it sits above
           the quick-add bar and steps aside while the move sheet is up -->
      <Button Classes="fab" Classes.raised="{Binding ShowsBoard}" Content="✦ Fettle" Command="{Binding FettleCommand}" IsVisible="{Binding FettleShows}"
              AutomationProperties.Name="Fettle"/>
    </Panel>
  </DockPanel>
</UserControl>
