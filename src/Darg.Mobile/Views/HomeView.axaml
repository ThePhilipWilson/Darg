<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Darg.Mobile.ViewModels"
             xmlns:views="using:Darg.Mobile.Views"
             x:Class="Darg.Mobile.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             x:Name="Root">
  <DockPanel Margin="16,8,16,0">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Classes="icon" Content="⟳" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh"/>
        <TextBlock Text="{Binding BoardLine}" Classes="dim" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Classes.bad="{Binding Bad}" Classes="dim" Margin="0,0,0,8"
                 IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,96">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:HomeTile">
            <StackPanel Margin="0,8,0,4">
              <TextBlock Text="{Binding Heading}" Classes="section"/>
              <TextBlock Text="{Binding Empty}" Classes="dim" IsVisible="{Binding IsEmpty}" Margin="0,2,0,6" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ReadRow">
            <Button Classes="row" Command="{Binding #Root.((vm:HomeViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                    IsHitTestVisible="{Binding CanOpen}" AutomationProperties.Name="{Binding Title}">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding HasBadge}" VerticalAlignment="Top" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Badge}" Classes="badge"/>
                </Border>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Classes.strong="{Binding Strong}"/>
                  <TextBlock Text="{Binding Detail}" Classes="dim" TextWrapping="Wrap" IsVisible="{Binding HasDetail}"/>
                </StackPanel>
              </DockPanel>
            </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
