<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.Desktop.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Workbench.Desktop.Views.CodeView"
             x:DataType="vm:CodeViewModel">
  <Grid ColumnDefinitions="320,*" RowDefinitions="*,Auto">
    <!-- the repos -->
    <Border Grid.RowSpan="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="10" Spacing="6">
          <TextBox Text="{Binding Find}" PlaceholderText="Find a file…"/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="↻" Command="{Binding ReloadCommand}" ToolTip.Tip="Read the repos again" Padding="8,2"/>
            <ToggleButton Classes="chip" Content="Changed only" IsChecked="{Binding ChangedOnly}"/>
          </DockPanel>
        </StackPanel>
        <Panel>
          <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" IsVisible="{Binding !Finding}" Background="Transparent">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:TreeNode">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:TreeNode" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Name}" Classes="mono" Classes.dir="{Binding IsDir}"/>
                  <TextBlock Text="{Binding Change}" Foreground="{StaticResource Accent}" FontSize="11" IsVisible="{Binding Changed}"/>
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <ListBox ItemsSource="{Binding Hits}" IsVisible="{Binding Finding}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileHit">
                <Button Command="{Binding Command}" Background="Transparent" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Name}" Classes="mono"/>
                      <TextBlock Text="{Binding Change}" Foreground="{StaticResource Accent}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Where}" Classes="dim small" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </Border>

    <!-- open files -->
    <DockPanel Grid.Column="1">
      <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Current}" Background="{StaticResource Panel}"
               BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" IsVisible="{Binding Tabs.Count}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OpenFile">
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding FullPath}">
              <TextBlock Text="{Binding Name}" Classes="mono" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Change}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center"/>
              <Button Content="×" Command="{Binding CloseCommand}" Padding="4,0" Background="Transparent" MinHeight="0"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Panel>
        <ae:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True" FontFamily="{StaticResource Mono}" FontSize="13"
                       Background="{StaticResource Bg}" Padding="6,4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        <ScrollViewer x:Name="ImageBox" IsVisible="False" HorizontalScrollBarVisibility="Auto">
          <Image x:Name="Picture" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
        </ScrollViewer>
        <TextBlock x:Name="Why" Classes="dim" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
        <TextBlock Classes="dim" Text="Pick a file on the left." HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNull}}"/>
      </Panel>
    </DockPanel>

    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
      <TextBlock Classes="dim small" Text="{Binding Status}"/>
    </Border>
  </Grid>
</UserControl>
