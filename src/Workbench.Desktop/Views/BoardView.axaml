<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.Desktop.ViewModels"
             x:Class="Workbench.Desktop.Views.BoardView"
             x:DataType="vm:BoardViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
      <DockPanel>
        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Boards}" SelectedItem="{Binding SelectedBoard}" MinWidth="140" Margin="0,0,12,0"/>
        <CheckBox DockPanel.Dock="Right" Content="Show completed" IsChecked="{Binding ShowCompleted}" Margin="12,0,0,0"/>
        <TextBlock DockPanel.Dock="Right" Classes="dim" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBox Text="{Binding Filter}" PlaceholderText="Filter by ID, title or description…" MaxWidth="460" HorizontalAlignment="Left" MinWidth="280"/>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8,14,3">
      <ItemsControl ItemsSource="{Binding Labels}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LabelChip">
            <ToggleButton Classes="chip" Content="{Binding Name}" IsChecked="{Binding IsOn}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Lists}" Margin="10">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ListViewModel">
            <Border Width="290" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
                    DragDrop.AllowDrop="True" Tag="{Binding Id}" Classes="list">
              <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="dim small" Text="{Binding Count}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Dim}"/>
                  </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Cards}" Margin="8">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CardViewModel">
                        <Border Classes="card" Cursor="Hand" ToolTip.Tip="{Binding Description}" Tag="{Binding}">
                          <Border.ContextMenu>
                            <ContextMenu ItemsSource="{Binding MoveTargets}">
                              <ContextMenu.Styles>
                                <Style Selector="MenuItem" x:DataType="vm:MoveTarget">
                                  <Setter Property="Header" Value="{Binding Label}"/>
                                  <Setter Property="Command" Value="{Binding Command}"/>
                                </Style>
                              </ContextMenu.Styles>
                            </ContextMenu>
                          </Border.ContextMenu>
                          <StackPanel Spacing="4">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" IsVisible="{Binding HasPriority}" Background="#3a3020" CornerRadius="8" Padding="6,0">
                                <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="{StaticResource Accent}"/>
                              </Border>
                              <TextBlock Classes="dim mono" FontSize="11" Text="{Binding Id}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding Labels}">
                              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <Border Classes="label"><TextBlock Text="{Binding}" FontSize="10" Foreground="#c6ccd6"/></Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
