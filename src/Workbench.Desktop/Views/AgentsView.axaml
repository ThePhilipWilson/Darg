<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Workbench.Desktop.ViewModels"
             x:Class="Workbench.Desktop.Views.AgentsView"
             x:DataType="vm:AgentsViewModel">
  <Grid ColumnDefinitions="280,*">
    <!-- agent list -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="10" Spacing="6">
          <TextBox Text="{Binding NewPrompt}" PlaceholderText="What should a new agent do?" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
          <TextBlock Classes="dim small" Text="{Binding Folder, StringFormat='Runs in {0}'}" TextWrapping="Wrap"/>
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="+ New agent" Command="{Binding StartAgentCommand}"/>
        </StackPanel>
        <ScrollViewer>
        <StackPanel>
        <TextBlock Text="This project" Classes="dim small" Margin="12,10,12,4"/>
        <ListBox ItemsSource="{Binding Agents}" SelectedItem="{Binding Selected}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AgentViewModel">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Background="Transparent" MinHeight="0" VerticalAlignment="Center"
                        Command="{Binding $parent[UserControl].((vm:AgentsViewModel)DataContext).ForgetCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Forget this agent (Claude Code keeps its own history)" AutomationProperties.Name="Forget agent"/>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Classes="dim small" Text="{Binding StateText}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="No agents yet." Classes="dim small" Margin="12,2,12,6" IsVisible="{Binding !Agents.Count}"/>

        <!-- Fettle's chats started in this project (Fettle lists the project on screen) -->
        <TextBlock Text="Fettle chats" Classes="dim small" Margin="12,14,12,4"/>
        <ListBox ItemsSource="{Binding Mascot.Chats, FallbackValue={x:Null}}" SelectedItem="{Binding BenchChat}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatEntry">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Classes="dim small" Text="{Binding When, StringFormat='Fettle · {0}'}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="None yet: talk to Fettle (bottom right)." Classes="dim small" Margin="12,2,12,6"
                   IsVisible="{Binding !Mascot.Chats.Count, FallbackValue=True}"/>
        </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- the selected agent -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" DataContext="{Binding Shown}" x:DataType="vm:AgentViewModel"
          IsVisible="{Binding $parent[UserControl].((vm:AgentsViewModel)DataContext).Shown, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" IsEnabled="{Binding Open}" Margin="6,0,0,0"
                  ToolTip.Tip="End this agent's Claude session. The agent stays listed; send it a message to carry on." AutomationProperties.Name="Close session"/>
          <Button DockPanel.Dock="Right" Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding Working}"
                  ToolTip.Tip="Stop the turn in progress; the session stays open"/>
          <!-- change the session as it runs: from its next turn (a saved agent starts with these when it resumes) -->
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0">
            <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding ModelChoice}" FontSize="12" MinHeight="0" Padding="8,3"
                      ToolTip.Tip="Model, from the next turn" AutomationProperties.Name="Model"/>
            <ComboBox ItemsSource="{Binding EffortChoices}" SelectedItem="{Binding EffortChoice}" FontSize="12" MinHeight="0" Padding="8,3"
                      ToolTip.Tip="Effort, from the next turn" AutomationProperties.Name="Effort"/>
            <ComboBox ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding ModeChoice}" FontSize="12" MinHeight="0" Padding="8,3"
                      ToolTip.Tip="Permission mode" AutomationProperties.Name="Permission mode"/>
          </StackPanel>
          <!-- a DockPanel, not a StackPanel, so the folder (last) gets only the room left and trims instead of running under the pickers -->
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Classes="dim small" Text="{Binding StateText}" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Classes="dim small mono" Text="{Binding Model}" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,12,0" Classes="dim small" Text="{Binding Billing}" VerticalAlignment="Center"/>
            <TextBlock Classes="dim small mono" Text="{Binding Cwd}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Cwd}"/>
          </DockPanel>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" x:Name="Scroll">
        <ItemsControl ItemsSource="{Binding Items}" Margin="18,14" MaxWidth="980" HorizontalAlignment="Left">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="primary" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
          <Button DockPanel.Dock="Right" Content="✎ Draw" Command="{Binding DrawCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                  ToolTip.Tip="Ask this agent for a canvas (claude-draw). What you've typed says what it's about; the drawing comes back here."/>
          <TextBox x:Name="ComposeBox" Text="{Binding Compose}" PlaceholderText="Message this agent… (Enter sends, Shift+Enter for a new line)"
                   AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"/>
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                IsVisible="{Binding Shown, Converter={x:Static ObjectConverters.IsNull}}">
      <TextBlock Text="No agent selected" FontSize="16" HorizontalAlignment="Center"/>
      <TextBlock Classes="dim" Text="Describe a job on the left to start one." HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
