<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Android head (AND-0003): hosts Darg.Mobile's views. Not in Darg.sln: it needs the android workload, which
       the system dotnet doesn't have; tools/android-setup.ps1 installs a dotnet that does, tools/android.ps1 builds
       and installs with it. Debug builds are signed with the SDK's debug key; Release with the keystore named by
       DARG_ANDROID_KEYSTORE (and _ALIAS, _PASS), when set. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>uk.co.philipwilson.darg</ApplicationId>
    <ApplicationTitle>Darg</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RootNamespace>Darg.Android</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(DARG_ANDROID_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(DARG_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(DARG_ANDROID_KEYSTORE_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>env:DARG_ANDROID_KEYSTORE_PASS</AndroidSigningKeyPass>
    <AndroidSigningStorePass>env:DARG_ANDROID_KEYSTORE_PASS</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
    <PackageReference Include="Xamarin.GooglePlayServices.Code.Scanner" Version="116.1.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Darg.Mobile\Darg.Mobile.csproj" />
  </ItemGroup>
</Project>
